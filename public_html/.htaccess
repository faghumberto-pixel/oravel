<IfModule mod_rewrite.c>
RewriteEngine On
# "Soluções" saiu do site (15/10/2026): só existem as Frentes da home
RewriteRule ^solucoes(\.php|/.*)?$ https://oravel.com.br/#frentes [R=301,NE,L]
# Páginas antigas de FSM e PCM foram absorvidas por Manutenção Industrial
RewriteRule ^(fsm|pcm)/?$ https://oravel.com.br/software-manutencao-industrial/ [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^solucoes/([a-z]+)$ solucoes/$1.html [L]
RewriteRule ^(.+)\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ $1.html [L]
</IfModule>
