<script>
// ===== CALCULADORA DISPONIBILIDADE v1.0 =====

const DEFAULTS_DISP = {
  codEquipDisp: 'EXC-001',
  modoCalculo: 'equipamento',
  categoriaDisp: 'escavadeira',
  qtdEquipamentos: 1,
  mesRef: '2026-11',
  horasPeriodo: 720,
  numFalhas: 3,
  tempoTotalReparo: 18,
  mttrInput: '',
  mtbfInput: '',
  tempPrev: 8,
  tempInsp: 4,
  tempLog: 6,
  tempPeca: 12,
  tempOp: 3,
  tempOutros: 2,
  diariaDisp: 450,
  taxaOcupacao: 75,
  custoHoraParado: ''
};

const inputs = {};
Object.keys(DEFAULTS_DISP).forEach(key => {
  inputs[key] = document.getElementById(key);
});

const fmtBRL = (v) => new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL', minimumFractionDigits: 0 }).format(Math.round(v));
const fmtBRL2 = (v) => new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL', minimumFractionDigits: 2 }).format(v);
const fmtNum = (v, d = 1) => new Intl.NumberFormat('pt-BR', { minimumFractionDigits: d, maximumFractionDigits: d }).format(v);
const fmtPct = (v) => new Intl.NumberFormat('pt-BR', { style: 'percent', minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(v / 100);

// Benchmarks simulados por categoria (P25, P50, P75 de Disponibilidade Física %)
const BENCHMARKS = {
  escavadeira: { p25: 82, p50: 88, p75: 93 },
  pacarreira: { p25: 85, p50: 90, p75: 94 },
  motoniveladora: { p25: 80, p50: 86, p75: 92 },
  rolo: { p25: 88, p50: 92, p75: 96 },
  plataforma: { p25: 90, p50: 94, p75: 97 },
  guindaste: { p25: 78, p50: 85, p75: 91 },
  gerador: { p25: 92, p50: 96, p75: 98 },
  compressor: { p25: 88, p50: 93, p75: 96 },
  outro: { p25: 80, p50: 87, p75: 92 }
};

function loadState() {
  const params = new URLSearchParams(window.location.search);
  let fromUrl = false;
  for (const [key, input] of Object.entries(inputs)) {
    const urlVal = params.get(key);
    if (urlVal !== null) { input.value = urlVal; fromUrl = true; }
  }
  if (!fromUrl) {
    for (const [key, input] of Object.entries(inputs)) {
      const saved = localStorage.getItem(`calc_disp_${key}`);
      if (saved !== null) input.value = saved;
    }
  }
}

function saveState() {
  for (const [key, input] of Object.entries(inputs)) {
    localStorage.setItem(`calc_disp_${key}`, input.value);
  }
}

function calcular() {
  const v = {};
  for (const [key, input] of Object.entries(inputs)) {
    const val = input.value;
    v[key] = (val === '' || isNaN(parseFloat(val))) ? val : parseFloat(val);
  }

  if (v.horasPeriodo <= 0) { alert('Horas no período > 0'); return; }
  if (v.numFalhas < 0) { alert('Falhas ≥ 0'); return; }
  if (v.tempoTotalReparo < 0) { alert('Tempo reparo ≥ 0'); return; }

  // MTTR
  let mttr = (v.mttrInput !== '' && !isNaN(v.mttrInput)) ? v.mttrInput : (v.numFalhas > 0 ? v.tempoTotalReparo / v.numFalhas : 0);
  // MTBF
  let mtbf = (v.mtbfInput !== '' && !isNaN(v.mtbfInput)) ? v.mtbfInput : (v.numFalhas > 0 ? (v.horasPeriodo - v.tempoTotalReparo) / v.numFalhas : v.horasPeriodo);

  // Tempos parados
  const tempoFalha = v.numFalhas * mttr;
  const tempoPrev = v.tempPrev || 0;
  const tempoInsp = v.tempInsp || 0;
  const tempoLog = v.tempLog || 0;
  const tempoPeca = v.tempPeca || 0;
  const tempoOp = v.tempOp || 0;
  const tempoOutros = v.tempOutros || 0;

  const totalParado = tempoFalha + tempoPrev + tempoInsp + tempoLog + tempoPeca + tempoOp + tempoOutros;
  const horasDisponiveis = Math.max(0, v.horasPeriodo - totalParado);

  // Disponibilidade Física
  const dispFisica = v.horasPeriodo > 0 ? (horasDisponiveis / v.horasPeriodo) * 100 : 0;
  // Disponibilidade Operacional
  const dispOper = dispFisica * (v.taxaOcupacao / 100);
  // Confiabilidade (probabilidade de operar sem falha por 100h)
  const confiabilidade = mtbf > 0 ? Math.exp(-100 / mtbf) * 100 : 100;

  // Receita perdida
  const custoHora = (v.custoHoraParado !== '' && !isNaN(v.custoHoraParado)) ? v.custoHoraParado : (v.diariaDisp / 8);
  const receitaPerdida = totalParado * custoHora * (v.taxaOcupacao / 100) * (v.qtdEquipamentos || 1);

  // Benchmark
  const cat = v.categoriaDisp || 'outro';
  const bench = BENCHMARKS[cat] || BENCHMARKS.outro;

  // Cenários
  const baseFalhas = v.numFalhas;
  const baseMttr = mttr;
  const basePrev = tempoPrev + tempoInsp;
  const baseLogPecaOp = tempoLog + tempoPeca + tempoOp;
  const baseOutros = tempoOutros;

  const cenarios = [
    { nome: 'Atual', falhas: baseFalhas, mttr: baseMttr, prev: basePrev, log: baseLogPecaOp, outros: baseOutros },
    { nome: 'Melhoria preventiva (-30% falhas)', falhas: Math.max(0, baseFalhas * 0.7), mttr: baseMttr, prev: basePrev * 1.1, log: baseLogPecaOp, outros: baseOutros },
    { nome: 'Oficina própria (-40% MTTR)', falhas: baseFalhas, mttr: baseMttr * 0.6, prev: basePrev, log: baseLogPecaOp * 0.5, outros: baseOutros },
    { nome: 'Gestão de peças (-50% espera peça)', falhas: baseFalhas, mttr: baseMttr, prev: basePrev, log: baseLogPecaOp - tempoPeca * 0.5, outros: baseOutros },
    { nome: 'Excelência (P75 mercado)', falhas: baseFalhas * 0.5, mttr: baseMttr * 0.5, prev: basePrev * 0.8, log: baseLogPecaOp * 0.3, outros: baseOutros * 0.5 },
  ];

  const cenarioResultados = cenarios.map(c => {
    const tf = c.falhas * c.mttr;
    const tp = tf + c.prev + c.log + c.outros;
    const hd = Math.max(0, v.horasPeriodo - tp);
    const df = v.horasPeriodo > 0 ? (hd / v.horasPeriodo) * 100 : 0;
    const rp = tp * custoHora * (v.taxaOcupacao / 100) * (v.qtdEquipamentos || 1);
    return { ...c, dispFisica: df, receitaPerdida: rp };
  });

  // Render
  document.getElementById('resCodDisp').textContent = v.codEquipDisp;
  document.getElementById('resDispFisica').textContent = fmtNum(dispFisica, 1) + '%';
  document.getElementById('resDispOper').textContent = fmtNum(dispOper, 1) + '%';
  document.getElementById('resReceitaPerdida').textContent = fmtBRL(receitaPerdida);
  document.getElementById('resMTBF').textContent = fmtNum(mtbf, 1) + ' h';
  document.getElementById('resMTTR').textContent = fmtNum(mttr, 1) + ' h';
  document.getElementById('resHorasParadas').textContent = fmtNum(totalParado, 1) + ' h';
  document.getElementById('resConfiabilidade').textContent = fmtNum(confiabilidade, 1) + '%';

  document.getElementById('breakdownDisp').innerHTML = [
    { label: 'Falhas (MTTR × Nº)', value: tempoFalha, cor: '#9a3412' },
    { label: 'Manutenção preventiva', value: tempoPrev, cor: '#0b5f57' },
    { label: 'Inspeções/Vistorias', value: tempoInsp, cor: '#0b5f57' },
    { label: 'Logística/Transporte', value: tempoLog, cor: '#f59e0b' },
    { label: 'Aguardando peça', value: tempoPeca, cor: '#f59e0b' },
    { label: 'Aguardando operador/técnico', value: tempoOp, cor: '#f59e0b' },
    { label: 'Outros administrativos', value: tempoOutros, cor: '#6b7280' },
    { label: '<strong>Total Parado</strong>', value: totalParado, total: true },
    { label: '<strong>Horas Disponíveis</strong>', value: horasDisponiveis, total: true, good: true }
  ].map(b => `
    <div style="${b.total ? 'font-weight:700;border-top:1px solid var(--cinza-claro);padding-top:8px;margin-top:4px' : ''} ${b.good ? 'color:var(--azul-petroleo)' : ''}">
      <span>${b.label}</span>
      <span style="text-align:right;display:block;color:${b.cor || 'var(--texto-escuro)'}">${b.total || b.good ? '<strong>' : ''}${fmtNum(b.value, 1)} h${b.total || b.good ? '</strong>' : ''}</span>
    </div>
  `).join('');

  document.getElementById('benchP25').textContent = bench.p25 + '%';
  document.getElementById('benchP50').textContent = bench.p50 + '%';
  document.getElementById('benchP75').textContent = bench.p75 + '%';

  // Pareto chart
  const paretoData = [
    { label: 'Aguardando peça', value: tempoPeca, cor: '#f59e0b' },
    { label: 'Falhas (reparo)', value: tempoFalha, cor: '#9a3412' },
    { label: 'Logística/Transporte', value: tempoLog, cor: '#f59e0b' },
    { label: 'Preventiva + Inspeção', value: tempoPrev + tempoInsp, cor: '#0b5f57' },
    { label: 'Aguardando operador', value: tempoOp, cor: '#f59e0b' },
    { label: 'Outros', value: tempoOutros, cor: '#6b7280' }
  ].filter(d => d.value > 0).sort((a,b) => b.value - a.value);

  const ctx = document.getElementById('chartParetoDisp');
  if (window.paretoChart) window.paretoChart.destroy();
  window.paretoChart = new Chart(ctx, {
    type: 'bar',
    data: {
      labels: paretoData.map(d => d.label),
      datasets: [{
        label: 'Horas paradas',
        data: paretoData.map(d => d.value),
        backgroundColor: paretoData.map(d => d.cor),
        borderRadius: 6
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      indexAxis: 'y',
      plugins: {
        legend: { display: false },
        tooltip: { backgroundColor: '#1b2230', titleColor: '#fff', bodyColor: '#e8f1ef', padding: 12, cornerRadius: 8 }
      },
      scales: {
        x: { grid: { color: '#f0efe9' }, ticks: { color: '#6b7280', font: { size: 12 } }, beginAtZero: true },
        y: { grid: { display: false }, ticks: { color: '#4a5361', font: { size: 12 } } }
      }
    }
  });

  const tb = document.getElementById('tbodyCenariosDisp');
  tb.innerHTML = cenarioResultados.map(c => `
    <tr style="border-bottom:1px solid #f0efe9 ${c.nome === 'Atual' ? ';font-weight:600' : ''}">
      <td style="padding:10px 12px;color:var(--texto-escuro)">${c.nome}</td>
      <td style="padding:10px 12px;text-align:right;color:var(--texto-secundario)">${fmtNum(c.falhas, 1)}</td>
      <td style="padding:10px 12px;text-align:right;color:var(--texto-secundario)">${fmtNum(c.mttr, 1)}</td>
      <td style="padding:10px 12px;text-align:right;color:var(--texto-secundario)">${fmtNum(c.prev, 1)}</td>
      <td style="padding:10px 12px;text-align:right;color:var(--texto-secundario)">${fmtNum(c.log + c.outros, 1)}</td>
      <td style="padding:10px 12px;text-align:right;color:var(--texto-escuro);font-weight:600">${fmtNum(c.dispFisica, 1)}%</td>
      <td style="padding:10px 12px;text-align:right;color:#9a3412;font-weight:600">${fmtBRL(c.receitaPerdida)}</td>
    </tr>
  `).join('');

  document.getElementById('resultadosDisp').style.display = 'block';
  saveState();
}

// Eventos
document.getElementById('btnCalcDisp').addEventListener('click', calcular);
document.getElementById('btnResetDisp').addEventListener('click', () => {
  for (const [key, input] of Object.entries(inputs)) { input.value = DEFAULTS_DISP[key]; }
  localStorage.clear();
  document.getElementById('resultadosDisp').style.display = 'none';
});

document.getElementById('btnCopiarLinkDisp').addEventListener('click', () => {
  const params = new URLSearchParams();
  for (const [key, input] of Object.entries(inputs)) { params.set(key, input.value); }
  navigator.clipboard.writeText(`${window.location.origin}${window.location.pathname}?${params.toString()}`).then(() => {
    const btn = document.getElementById('btnCopiarLinkDisp');
    const orig = btn.textContent; btn.textContent = 'Copiado!'; setTimeout(() => btn.textContent = orig, 2000);
  });
});

document.getElementById('btnExportarCSVDisp').addEventListener('click', () => {
  const linhas = [
    ['Parâmetro', 'Valor'],
    ['Código', inputs.codEquipDisp.value],
    ['Modo', inputs.modoCalculo.value],
    ['Categoria', inputs.categoriaDisp.value],
    ['Qtd equipamentos', inputs.qtdEquipamentos.value],
    ['Mês ref', inputs.mesRef.value],
    ['Horas período', inputs.horasPeriodo.value],
    ['Nº falhas', inputs.numFalhas.value],
    ['Tempo total reparo (h)', inputs.tempoTotalReparo.value],
    ['MTTR (h)', inputs.mttrInput.value || 'auto'],
    ['MTBF (h)', inputs.mtbfInput.value || 'auto'],
    ['Prev (h)', inputs.tempPrev.value],
    ['Inspeção (h)', inputs.tempInsp.value],
    ['Logística (h)', inputs.tempLog.value],
    ['Aguardando peça (h)', inputs.tempPeca.value],
    ['Aguardando operador (h)', inputs.tempOp.value],
    ['Outros (h)', inputs.tempOutros.value],
    ['Diária (R$)', inputs.diariaDisp.value],
    ['Taxa ocupação (%)', inputs.taxaOcupacao.value],
    ['Custo hora parado (R$)', inputs.custoHoraParado.value || 'auto'],
    ['', ''],
    ['Resultado', 'Valor'],
    ['Disponibilidade Física (%)', document.getElementById('resDispFisica').textContent],
    ['Disponibilidade Operacional (%)', document.getElementById('resDispOper').textContent],
    ['MTBF (h)', document.getElementById('resMTBF').textContent],
    ['MTTR (h)', document.getElementById('resMTTR').textContent],
    ['Total horas paradas (h)', document.getElementById('resHorasParadas').textContent],
    ['Confiabilidade 100h (%)', document.getElementById('resConfiabilidade').textContent],
    ['Receita perdida (R$)', document.getElementById('resReceitaPerdida').textContent],
  ];
  const csv = linhas.map(r => r.map(c => `"${c}"`).join(',')).join('\n');
  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
  const link = document.createElement('a');
  link.href = URL.createObjectURL(blob);
  link.download = `disponibilidade-${inputs.codEquipDisp.value}-${new Date().toISOString().split('T')[0]}.csv`;
  link.click();
});

// Auto-calc
let timeout;
Object.values(inputs).forEach(input => {
  input.addEventListener('input', () => { clearTimeout(timeout); timeout = setTimeout(calcular, 300); });
  input.addEventListener('change', calcular);
});

// URL sync
Object.values(inputs).forEach(input => {
  input.addEventListener('change', () => {
    const params = new URLSearchParams();
    for (const [key, inp] of Object.entries(inputs)) { params.set(key, inp.value); }
    window.history.replaceState({}, '', `${window.location.pathname}?${params.toString()}`);
  });
});

// Init
loadState();
calcular();
</script>