<script>
// ===== CALCULADORA MARGEM POR EQUIPAMENTO v1.0 =====

const DEFAULTS_MARGEM = {
  codEquipamento: 'EXC-001',
  categoriaEquip: 'escavadeira',
  marcaModelo: 'Caterpillar 320D',
  anoFabricacao: 2022,
  custoAquisicao: 280000,
  vidaUtilHoras: 12000,
  horasAtuais: 3200,
  valorRevendaAtual: 180000,
  diariaPraticada: 450,
  diasAlugados: 18,
  horasMes: 144,
  combustivelLitros: 600,
  precoDiesel: 6.15,
  custoOperador: 4500,
  manutPrevMensal: 800,
  manutCorrMensal: 1200,
  seguroMensal: 650,
  rastreamentoMensal: 150,
  outrosFixosMensal: 0,
  custoCapital: 14.5,
  pctFinanciado: 0
};

const inputs = {};
Object.keys(DEFAULTS_MARGEM).forEach(key => {
  inputs[key] = document.getElementById(key);
});

const fmtBRL = (v) => new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL', minimumFractionDigits: 0 }).format(Math.round(v));
const fmtBRL2 = (v) => new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL', minimumFractionDigits: 2 }).format(v);
const fmtNum = (v, d = 0) => new Intl.NumberFormat('pt-BR', { minimumFractionDigits: d, maximumFractionDigits: d }).format(v);
const fmtPct = (v) => new Intl.NumberFormat('pt-BR', { style: 'percent', minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(v / 100);

function loadState() {
  const params = new URLSearchParams(window.location.search);
  let fromUrl = false;
  for (const [key, input] of Object.entries(inputs)) {
    const urlVal = params.get(key);
    if (urlVal !== null) { input.value = urlVal; fromUrl = true; }
  }
  if (!fromUrl) {
    for (const [key, input] of Object.entries(inputs)) {
      const saved = localStorage.getItem(`calc_margem_${key}`);
      if (saved !== null) input.value = saved;
    }
  }
}

function saveState() {
  for (const [key, input] of Object.entries(inputs)) {
    localStorage.setItem(`calc_margem_${key}`, input.value);
  }
}

function calcular() {
  const v = {};
  for (const [key, input] of Object.entries(inputs)) {
    const val = input.value;
    v[key] = isNaN(parseFloat(val)) ? val : parseFloat(val);
  }

  if (v.custoAquisicao <= 0) { alert('Custo de aquisição > 0'); return; }
  if (v.vidaUtilHoras <= 0) { alert('Vida útil > 0'); return; }
  if (v.horasAtuais > v.vidaUtilHoras) { alert('Horas atuais não podem exceder vida útil'); return; }

  // 1. Receita mensal
  const receitaMensal = v.diariaPraticada * v.diasAlugados;

  // 2. Custos variáveis mensais
  const custoCombustivel = v.combustivelLitros * v.precoDiesel;
  const custoOperador = v.custoOperador;
  const custosVariaveis = custoCombustivel + custoOperador;

  // 3. Margem Bruta
  const margemBruta = receitaMensal - custosVariaveis;
  const margemBrutaPct = receitaMensal > 0 ? (margemBruta / receitaMensal) * 100 : 0;

  // 4. Custos fixos mensais
  const custosFixos = v.manutPrevMensal + v.manutCorrMensal + v.seguroMensal + v.rastreamentoMensal + v.outrosFixosMensal;

  // 4. Depreciação mensal (linear por horas)
  const horasRestantes = v.vidaUtilHoras - v.horasAtuais;
  const valorDepreciavel = v.custoAquisicao - v.valorRevendaAtual;
  const depreciacaoPorHora = horasRestantes > 0 ? valorDepreciavel / horasRestantes : 0;
  const depreciacaoMensal = depreciacaoPorHora * v.horasMes;

  // 5. Custo de capital mensal (sobre valor médio do ativo)
  const valorMedioAtivo = (v.custoAquisicao + v.valorRevendaAtual) / 2;
  const custoCapitalMensal = valorMedioAtivo * (v.custoCapital / 100) / 12;

  // 6. Margem Líquida
  const margemLiquida = margemBruta - custosFixos - depreciacaoMensal - custoCapitalMensal;
  const margemLiquidaPct = receitaMensal > 0 ? (margemLiquida / receitaMensal) * 100 : 0;

  // 7. Payback (meses para recuperar custo de aquisição com margem líquida)
  // Usa o fluxo de caixa (antes de depreciação e custo de capital, que já embutem o próprio investimento)
  const caixaMensal = margemBruta - custosFixos;
  const paybackMeses = caixaMensal > 0 ? v.custoAquisicao / caixaMensal : Infinity;

  // 8. ROI Anual (%)
  const roiAnual = v.custoAquisicao > 0 ? (margemLiquida * 12 / v.custoAquisicao) * 100 : 0;

  // 9. Vida restante %
  const vidaRestantePct = v.vidaUtilHoras > 0 ? (horasRestantes / v.vidaUtilHoras) * 100 : 0;

  // Breakdown
  const breakdown = [
    { label: 'Receita mensal (diária × dias)', value: receitaMensal, isRevenue: true },
    { label: 'Combustível', value: -custoCombustivel },
    { label: 'Operador dedicado', value: -custoOperador },
    { label: '<strong>Margem Bruta</strong>', value: margemBruta, subtotal: true },
    { label: 'Manutenção preventiva', value: -v.manutPrevMensal },
    { label: 'Manutenção corretiva', value: -v.manutCorrMensal },
    { label: 'Seguro', value: -v.seguroMensal },
    { label: 'Rastreamento/Telemetria', value: -v.rastreamentoMensal },
    { label: 'Outros fixos', value: -v.outrosFixosMensal },
    { label: 'Depreciação mensal', value: -depreciacaoMensal },
    { label: 'Custo de capital mensal', value: -custoCapitalMensal },
    { label: '<strong>Margem Líquida</strong>', value: margemLiquida, total: true }
  ];

  // Cenários
  const baseDias = v.diasAlugados;
  const baseDiaria = v.diariaPraticada;
  const baseManutCorr = v.manutCorrMensal;
  const cenarios = [
    { nome: 'Atual', dias: baseDias, diaria: baseDiaria, manutCorr: baseManutCorr },
    { nome: 'Otimista (+3 dias, +5% diária)', dias: Math.min(26, baseDias + 3), diaria: baseDiaria * 1.05, manutCorr: baseManutCorr * 0.9 },
    { nome: 'Conservador (-3 dias, -5% diária)', dias: Math.max(5, baseDias - 3), diaria: baseDiaria * 0.95, manutCorr: baseManutCorr * 1.15 },
    { nome: 'Alta utilização (22 dias)', dias: 22, diaria: baseDiaria, manutCorr: baseManutCorr * 1.1 },
    { nome: 'Diária de mercado (+10%)', dias: baseDias, diaria: baseDiaria * 1.10, manutCorr: baseManutCorr },
    { nome: 'Manut. preventiva rigorosa (-30% corr.)', dias: baseDias, diaria: baseDiaria, manutCorr: baseManutCorr * 0.7 },
  ];

  const cenarioResultados = cenarios.map(c => {
    const rec = c.diaria * c.dias;
    const comb = v.combustivelLitros * v.precoDiesel * (baseDias > 0 ? c.dias / baseDias : 1); // escala combustível
    const op = v.custoOperador;
    const mb = rec - comb - op;
    const fix = v.manutPrevMensal + c.manutCorr + v.seguroMensal + v.rastreamentoMensal + v.outrosFixosMensal;
    const dep = depreciacaoMensal;
    const cap = custoCapitalMensal;
    const ml = mb - fix - dep - cap;
    const delta = margemLiquida !== 0 ? ((ml - margemLiquida) / Math.abs(margemLiquida)) * 100 : 0;
    return { ...c, margemLiquida: ml, delta };
  });

  // Recomendação
  let recomendacao = '';
  let recClass = '';
  if (margemLiquida > 0 && roiAnual > v.custoCapital) {
    recomendacao = `<strong>MANTER</strong> — Equipamento rentável (ROI ${fmtNum(roiAnual,1)}% > custo de capital ${fmtNum(v.custoCapital,1)}%). Margem líquida de ${fmtBRL(margemLiquida)}/mês. Payback em ${fmtNum(paybackMeses,1)} meses.`;
    recClass = 'style="background:#e7f1ef;border-color:var(--azul-petroleo)"';
  } else if (margemLiquida > 0 && roiAnual <= v.custoCapital) {
    recomendacao = `<strong>MANTER COM ATENÇÃO</strong> — Margem positiva (${fmtBRL(margemLiquida)}/mês) mas ROI (${fmtNum(roiAnual,1)}%) abaixo do custo de capital (${fmtNum(v.custoCapital,1)}%). Considere: aumentar diária, reduzir manutenção corretiva ou vender se houver oportunidade.`;
    recClass = 'style="background:#fef3e7;border-color:#f59e0b"';
  } else if (margemLiquida <= 0 && vidaRestantePct > 30) {
    recomendacao = `<strong>REVISAR URGENTE</strong> — Margem negativa (${fmtBRL(margemLiquida)}/mês). Vida restante: ${fmtNum(vidaRestantePct,0)}%. Ações: renegociar diária, auditar manutenção corretiva, avaliar terceirização de operador, ou vender.`;
    recClass = 'style="background:#fef3e7;border-color:#9a3412"';
  } else {
    recomendacao = `<strong>VENDER / SUBSTITUIR</strong> — Margem negativa (${fmtBRL(margemLiquida)}/mês) e vida restante baixa (${fmtNum(vidaRestantePct,0)}%). Custo de oportunidade alto. Melhor alocar capital em equipamento mais rentável.`;
    recClass = 'style="background:#fef3e7;border-color:#9a3412"';
  }

  // Render
  document.getElementById('resCodEquip').textContent = v.codEquipamento;
  document.getElementById('resMargemBruta').textContent = fmtBRL(margemBruta);
  document.getElementById('resMargemLiquida').textContent = fmtBRL(margemLiquida);
  document.getElementById('resMargemPct').textContent = fmtNum(margemLiquidaPct, 1) + '%';
  document.getElementById('resPayback').textContent = isFinite(paybackMeses) ? fmtNum(paybackMeses, 1) : '—';
  document.getElementById('resROIAnual').textContent = fmtNum(roiAnual, 1) + '%';
  document.getElementById('resVidaRestante').textContent = fmtNum(vidaRestantePct, 0) + '%';

  document.getElementById('breakdownMargem').innerHTML = breakdown.map(b => `
    <div style="${b.total ? 'font-weight:700;color:var(--azul-petroleo);border-top:2px solid var(--azul-petroleo);padding-top:8px;margin-top:4px' : b.subtotal ? 'font-weight:600;color:var(--texto-escuro);border-top:1px solid var(--cinza-claro);padding-top:8px;margin-top:4px' : b.isRevenue ? 'font-weight:600;color:var(--azul-petroleo)' : ''}">
      <span>${b.label}</span>
      <span style="text-align:right;display:block;color:${b.value >= 0 ? 'var(--azul-petroleo)' : '#9a3412'}">${fmtBRL2(b.value)}</span>
    </div>
  `).join('');

  document.getElementById('recomendacaoBox').setAttribute('style', `padding:16px;border-radius:8px;${recClass || 'background:#fbfaf6;border:1px solid #e4dfd3'}`);
  document.getElementById('recomendacaoTexto').innerHTML = recomendacao;

  const tb = document.getElementById('tbodyCenariosMargem');
  tb.innerHTML = cenarioResultados.map(c => `
    <tr style="border-bottom:1px solid #f0efe9 ${c.nome === 'Atual' ? ';font-weight:600' : ''}">
      <td style="padding:10px 12px;color:var(--texto-escuro)">${c.nome}</td>
      <td style="padding:10px 12px;text-align:right;color:var(--texto-secundario)">${c.dias}</td>
      <td style="padding:10px 12px;text-align:right;color:var(--texto-secundario)">${fmtBRL(c.diaria)}</td>
      <td style="padding:10px 12px;text-align:right;color:var(--texto-secundario)">${fmtBRL(c.manutCorr)}</td>
      <td style="padding:10px 12px;text-align:right;color:var(--texto-escuro);font-weight:600">${fmtBRL(c.margemLiquida)}</td>
      <td style="padding:10px 12px;text-align:right;color:${c.delta > 0 ? 'var(--azul-petroleo)' : c.delta < 0 ? '#9a3412' : 'var(--texto-secundario)'};font-weight:600">${c.delta >= 0 ? '+' : ''}${fmtNum(c.delta, 1)}%</td>
    </tr>
  `).join('');

  document.getElementById('resultadosMargem').style.display = 'block';
  saveState();
}

// Eventos
document.getElementById('btnCalcMargem').addEventListener('click', calcular);
document.getElementById('btnResetMargem').addEventListener('click', () => {
  for (const [key, input] of Object.entries(inputs)) { input.value = DEFAULTS_MARGEM[key]; }
  localStorage.clear();
  document.getElementById('resultadosMargem').style.display = 'none';
});

document.getElementById('btnCopiarLinkMargem').addEventListener('click', () => {
  const params = new URLSearchParams();
  for (const [key, input] of Object.entries(inputs)) { params.set(key, input.value); }
  navigator.clipboard.writeText(`${window.location.origin}${window.location.pathname}?${params.toString()}`).then(() => {
    const btn = document.getElementById('btnCopiarLinkMargem');
    const orig = btn.textContent; btn.textContent = 'Copiado!'; setTimeout(() => btn.textContent = orig, 2000);
  });
});

document.getElementById('btnExportarCSVMargem').addEventListener('click', () => {
  const linhas = [
    ['Parâmetro', 'Valor'],
    ['Código', inputs.codEquipamento.value],
    ['Categoria', inputs.categoriaEquip.value],
    ['Marca/Modelo', inputs.marcaModelo.value],
    ['Ano', inputs.anoFabricacao.value],
    ['Custo aquisição', inputs.custoAquisicao.value],
    ['Vida útil (h)', inputs.vidaUtilHoras.value],
    ['Horas atuais', inputs.horasAtuais.value],
    ['Valor revenda atual', inputs.valorRevendaAtual.value],
    ['Diária', inputs.diariaPraticada.value],
    ['Dias alugados/mês', inputs.diasAlugados.value],
    ['Horas/mês', inputs.horasMes.value],
    ['Combustível (L)', inputs.combustivelLitros.value],
    ['Diesel (R$/L)', inputs.precoDiesel.value],
    ['Operador', inputs.custoOperador.value],
    ['Manut. preventiva', inputs.manutPrevMensal.value],
    ['Manut. corretiva', inputs.manutCorrMensal.value],
    ['Seguro', inputs.seguroMensal.value],
    ['Rastreamento', inputs.rastreamentoMensal.value],
    ['Outros fixos', inputs.outrosFixosMensal.value],
    ['Custo capital (% a.a.)', inputs.custoCapital.value],
    ['% Financiado', inputs.pctFinanciado.value],
    ['', ''],
    ['Resultado', 'Valor'],
    ['Margem Bruta', document.getElementById('resMargemBruta').textContent],
    ['Margem Líquida', document.getElementById('resMargemLiquida').textContent],
    ['% Margem Líquida', document.getElementById('resMargemPct').textContent],
    ['Payback (meses)', document.getElementById('resPayback').textContent],
    ['ROI Anual', document.getElementById('resROIAnual').textContent],
    ['Vida Restante (%)', document.getElementById('resVidaRestante').textContent],
  ];
  const csv = linhas.map(r => r.map(c => `"${c}"`).join(',')).join('\n');
  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
  const link = document.createElement('a');
  link.href = URL.createObjectURL(blob);
  link.download = `margem-${inputs.codEquipamento.value}-${new Date().toISOString().split('T')[0]}.csv`;
  link.click();
});

// Auto-calc
let timeout;
Object.values(inputs).forEach(input => {
  input.addEventListener('input', () => { clearTimeout(timeout); timeout = setTimeout(calcular, 300); });
  input.addEventListener('change', calcular);
});

// URL sync
Object.values(inputs).forEach(input => {
  input.addEventListener('change', () => {
    const params = new URLSearchParams();
    for (const [key, inp] of Object.entries(inputs)) { params.set(key, inp.value); }
    window.history.replaceState({}, '', `${window.location.pathname}?${params.toString()}`);
  });
});

// Init
loadState();
calcular();
</script>