<script>
// ===== CALCULADORA PREÇO DA DIÁRIA v1.0 =====
// Fórmula: TCO mensal / (horas disponíveis × utilização) × 8h = preço mínimo diária
// Preço sugerido = preço mínimo × (1 + margem%)

// Parâmetros default (baseados no Painel do Mercado P50)
const DEFAULTS = {
  custoAquisicao: 250000,
  vidaUtilMeses: 60,
  valorRevenda: 30000,
  utilizacaoPct: 65,
  horasPorDia: 8,
  diasUteisMes: 22,
  mesesPorAno: 12,
  custoManutencaoMes: 3500,
  custoSeguroMes: 800,
  custoRastreamentoMes: 180,
  outrosCustosMes: 0,
  custoCapitalAnual: 14.5,
  margemDesejada: 30
};

// Elementos DOM
const inputs = {
  custoAquisicao: document.getElementById('custoAquisicao'),
  vidaUtilMeses: document.getElementById('vidaUtilMeses'),
  valorRevenda: document.getElementById('valorRevenda'),
  utilizacaoPct: document.getElementById('utilizacaoPct'),
  horasPorDia: document.getElementById('horasPorDia'),
  diasUteisMes: document.getElementById('diasUteisMes'),
  mesesPorAno: document.getElementById('mesesPorAno'),
  custoManutencaoMes: document.getElementById('custoManutencaoMes'),
  custoSeguroMes: document.getElementById('custoSeguroMes'),
  custoRastreamentoMes: document.getElementById('custoRastreamentoMes'),
  outrosCustosMes: document.getElementById('outrosCustosMes'),
  custoCapitalAnual: document.getElementById('custoCapitalAnual'),
  margemDesejada: document.getElementById('margemDesejada')
};

const resultadosDiv = document.getElementById('resultados');
const btnCalcular = document.getElementById('btnCalcular');
const btnResetar = document.getElementById('btnResetar');
const btnCopiarLink = document.getElementById('btnCopiarLink');
const btnExportarCSV = document.getElementById('btnExportarCSV');

// Formatters
const fmtBRL = (v) => new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL', minimumFractionDigits: 2 }).format(v);
const fmtNum = (v, d = 0) => new Intl.NumberFormat('pt-BR', { minimumFractionDigits: d, maximumFractionDigits: d }).format(v);
const fmtPct = (v) => new Intl.NumberFormat('pt-BR', { style: 'percent', minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(v / 100);

// Carregar de localStorage ou URL
function loadState() {
  // URL params têm prioridade
  const params = new URLSearchParams(window.location.search);
  let loadedFromUrl = false;
  for (const [key, input] of Object.entries(inputs)) {
    const urlVal = params.get(key);
    if (urlVal !== null) {
      input.value = urlVal;
      loadedFromUrl = true;
    }
  }
  if (!loadedFromUrl) {
    // localStorage
    for (const [key, input] of Object.entries(inputs)) {
      const saved = localStorage.getItem(`calc_preco_diaria_${key}`);
      if (saved !== null) input.value = saved;
    }
  }
  // Se nada, usa defaults (já no HTML)
}

function saveState() {
  for (const [key, input] of Object.entries(inputs)) {
    localStorage.setItem(`calc_preco_diaria_${key}`, input.value);
  }
}

// Cálculo principal
function calcular() {
  const vals = {};
  for (const [key, input] of Object.entries(inputs)) {
    vals[key] = parseFloat(input.value) || 0;
  }

  // Validações básicas
  if (vals.custoAquisicao <= 0) { alert('Custo de aquisição deve ser > 0'); return; }
  if (vals.vidaUtilMeses <= 0) { alert('Vida útil deve ser > 0'); return; }
  if (vals.utilizacaoPct <= 0 || vals.utilizacaoPct > 100) { alert('Utilização deve ser entre 1 e 100%'); return; }

  // 1. Depreciação mensal (linear)
  const baseDepreciavel = vals.custoAquisicao - vals.valorRevenda;
  const depreciacaoMensal = baseDepreciavel / vals.vidaUtilMeses;

  // 2. Custo de capital mensal (sobre valor médio do ativo)
  // Valor médio ≈ (custoAquisicao + valorRevenda) / 2
  const valorMedioAtivo = (vals.custoAquisicao + vals.valorRevenda) / 2;
  const custoCapitalMensal = valorMedioAtivo * (vals.custoCapitalAnual / 100) / 12;

  // 3. Custos operacionais mensais (inputs diretos)
  const custosOperacionaisMes = vals.custoManutencaoMes + vals.custoSeguroMes + vals.custoRastreamentoMes + vals.outrosCustosMes;

  // 4. Custo total mensal (TCO mensal)
  const tcoMensal = depreciacaoMensal + custoCapitalMensal + custosOperacionaisMes;

  // 5. Horas disponíveis por mês
  const horasDisponiveisMes = vals.horasPorDia * vals.diasUteisMes;

  // 6. Horas efetivamente alugadas por mês (com utilização)
  const horasAlugadasMes = horasDisponiveisMes * (vals.utilizacaoPct / 100);

  // 7. Custo por hora disponível (para referência)
  const custoHoraDisponivel = tcoMensal / horasDisponiveisMes;

  // 8. Preço mínimo por hora (para cobrir custos na utilização esperada)
  const precoMinimoHora = tcoMensal / horasAlugadasMes;

  // 9. Preço mínimo da diária (8h)
  const precoMinimoDiaria = precoMinimoHora * 8;

  // 10. Preço sugerido com margem
  const precoSugeridoDiaria = precoMinimoDiaria * (1 + vals.margemDesejada / 100);

  // 11. Ponto de equilíbrio (dias/mês para cobrir TCO com preço sugerido)
  const receitaPorDia = precoSugeridoDiaria;
  const pontoEquilibrioDias = tcoMensal / receitaPorDia;

  // 12. Payback em meses (considerando fluxo de caixa líquido mensal na utilização esperada)
  const receitaMensalEsperada = precoSugeridoDiaria * (horasAlugadasMes / 8);
  // Fluxo de caixa: receita - custos desembolsáveis (depreciação e custo de capital já representam o próprio investimento)
  const fluxoLiquidoMensal = receitaMensalEsperada - custosOperacionaisMes;
  const paybackMeses = fluxoLiquidoMensal > 0 ? vals.custoAquisicao / fluxoLiquidoMensal : Infinity;

  // Breakdown para exibição
  const breakdown = [
    { label: 'Depreciação mensal', value: depreciacaoMensal },
    { label: 'Custo de capital mensal', value: custoCapitalMensal },
    { label: 'Manutenção', value: vals.custoManutencaoMes },
    { label: 'Seguro', value: vals.custoSeguroMes },
    { label: 'Rastreamento/Telemetria', value: vals.custoRastreamentoMes },
    { label: 'Outros custos fixos', value: vals.outrosCustosMes },
    { label: '<strong>TCO Mensal Total</strong>', value: tcoMensal, total: true }
  ];

  // Sensibilidade
  const cenarios = [
    { nome: 'Base (atual)', util: vals.utilizacaoPct, cap: vals.custoCapitalAnual },
    { nome: 'Utilização -10pp', util: Math.max(10, vals.utilizacaoPct - 10), cap: vals.custoCapitalAnual },
    { nome: 'Utilização +10pp', util: Math.min(100, vals.utilizacaoPct + 10), cap: vals.custoCapitalAnual },
    { nome: 'Custo capital -2pp', util: vals.utilizacaoPct, cap: Math.max(0, vals.custoCapitalAnual - 2) },
    { nome: 'Custo capital +2pp', util: vals.utilizacaoPct, cap: vals.custoCapitalAnual + 2 },
    { nome: 'Pessimista (-10pp util, +2pp cap)', util: Math.max(10, vals.utilizacaoPct - 10), cap: vals.custoCapitalAnual + 2 },
    { nome: 'Otimista (+10pp util, -2pp cap)', util: Math.min(100, vals.utilizacaoPct + 10), cap: Math.max(0, vals.custoCapitalAnual - 2) }
  ];

  const sensibilidade = cenarios.map(c => {
    const baseDep = baseDepreciavel / vals.vidaUtilMeses;
    const valMed = (vals.custoAquisicao + vals.valorRevenda) / 2;
    const capMes = valMed * (c.cap / 100) / 12;
    const tco = baseDep + capMes + custosOperacionaisMes;
    const hDisp = vals.horasPorDia * vals.diasUteisMes;
    const hAlug = hDisp * (c.util / 100);
    const precoMinH = tco / hAlug;
    const precoSug = precoMinH * 8 * (1 + vals.margemDesejada / 100);
    const delta = precoSugeridoDiaria > 0 ? ((precoSug - precoSugeridoDiaria) / precoSugeridoDiaria) * 100 : 0;
    return { ...c, precoSugerido: precoSug, delta };
  });

  // Render
  renderResultados({
    precoMinimoDiaria,
    precoSugeridoDiaria,
    custoHoraDisponivel,
    pontoEquilibrioDias,
    paybackMeses,
    breakdown,
    sensibilidade,
    margem: vals.margemDesejada
  });

  resultadosDiv.style.display = 'block';
  saveState();
}

function renderResultados(r) {
  document.getElementById('resultadoPrecoMinimo').textContent = fmtBRL(r.precoMinimoDiaria);
  document.getElementById('resultadoPrecoSugerido').textContent = fmtBRL(r.precoSugeridoDiaria);
  document.getElementById('margemDisplay').textContent = fmtNum(r.margem);
  document.getElementById('metricCustoHora').textContent = fmtBRL(r.custoHoraDisponivel);
  document.getElementById('metricPontoEquilibrio').textContent = fmtNum(r.pontoEquilibrioDias, 1);
  document.getElementById('metricPaybackMeses').textContent = isFinite(r.paybackMeses) ? fmtNum(r.paybackMeses, 1) : '—';

  // Breakdown
  const bdDiv = document.getElementById('breakdownCustos');
  bdDiv.innerHTML = r.breakdown.map(b => `
    <div style="${b.total ? 'font-weight:700;color:var(--azul-petroleo);border-top:1px solid var(--cinza-claro);padding-top:8px;margin-top:4px' : ''}">
      <span>${b.label}</span>
      <span style="text-align:right;display:block">${fmtBRL(b.value)}</span>
    </div>
  `).join('');

  // Sensibilidade
  const tb = document.getElementById('tbodySensibilidade');
  tb.innerHTML = r.sensibilidade.map(s => `
    <tr style="border-bottom:1px solid #f0efe9">
      <td style="padding:10px 12px;color:var(--texto-escuro);font-weight:${s.nome === 'Base (atual)' ? '600' : '400'}">${s.nome}</td>
      <td style="padding:10px 12px;text-align:right;color:var(--texto-secundario)">${fmtPct(s.util)}</td>
      <td style="padding:10px 12px;text-align:right;color:var(--texto-secundario)">${fmtPct(s.cap)}</td>
      <td style="padding:10px 12px;text-align:right;color:var(--texto-escuro);font-weight:600">${fmtBRL(s.precoSugerido)}</td>
      <td style="padding:10px 12px;text-align:right;color:${s.delta > 0 ? '#9a3412' : s.delta < 0 ? 'var(--azul-petroleo)' : 'var(--texto-secundario)'};font-weight:600">${s.delta >= 0 ? '+' : ''}${fmtNum(s.delta, 1)}%</td>
    </tr>
  `).join('');
}

// Copiar link com parâmetros
btnCopiarLink.addEventListener('click', () => {
  const params = new URLSearchParams();
  for (const [key, input] of Object.entries(inputs)) {
    params.set(key, input.value);
  }
  const url = `${window.location.origin}${window.location.pathname}?${params.toString()}`;
  navigator.clipboard.writeText(url).then(() => {
    const original = btnCopiarLink.textContent;
    btnCopiarLink.textContent = 'Link copiado!';
    setTimeout(() => btnCopiarLink.textContent = original, 2000);
  });
});

// Exportar CSV
btnExportarCSV.addEventListener('click', () => {
  const params = new URLSearchParams();
  for (const [key, input] of Object.entries(inputs)) {
    params.set(key, input.value);
  }
  const linhas = [
    ['Parâmetro', 'Valor'],
    ['Custo de aquisição (R$)', inputs.custoAquisicao.value],
    ['Vida útil (meses)', inputs.vidaUtilMeses.value],
    ['Valor de revenda (R$)', inputs.valorRevenda.value],
    ['Utilização (%)', inputs.utilizacaoPct.value],
    ['Horas/dia', inputs.horasPorDia.value],
    ['Dias úteis/mês', inputs.diasUteisMes.value],
    ['Meses/ano', inputs.mesesPorAno.value],
    ['Manutenção (R$/mês)', inputs.custoManutencaoMes.value],
    ['Seguro (R$/mês)', inputs.custoSeguroMes.value],
    ['Rastreamento (R$/mês)', inputs.custoRastreamentoMes.value],
    ['Outros custos (R$/mês)', inputs.outrosCustosMes.value],
    ['Custo de capital (% a.a.)', inputs.custoCapitalAnual.value],
    ['Margem desejada (%)', inputs.margemDesejada.value],
    ['', ''],
    ['Resultado', 'Valor'],
    ['Preço MÍNIMO diária (8h)', document.getElementById('resultadoPrecoMinimo').textContent],
    ['Preço SUGERIDO diária (8h)', document.getElementById('resultadoPrecoSugerido').textContent],
    ['Custo/hora disponível', document.getElementById('metricCustoHora').textContent],
    ['Dias/mês p/ equilíbrio', document.getElementById('metricPontoEquilibrio').textContent],
    ['Payback (meses)', document.getElementById('metricPaybackMeses').textContent],
  ];
  const csv = linhas.map(r => r.map(c => `"${c}"`).join(',')).join('\n');
  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
  const link = document.createElement('a');
  link.href = URL.createObjectURL(blob);
  link.download = `calculadora-preco-diaria-${new Date().toISOString().split('T')[0]}.csv`;
  link.click();
});

// Resetar
btnResetar.addEventListener('click', () => {
  for (const [key, input] of Object.entries(inputs)) {
    input.value = DEFAULTS[key];
  }
  localStorage.clear(); // limpa todos os keys da calculadora
  resultadosDiv.style.display = 'none';
});

// Auto-calcular ao mudar inputs (com debounce)
let calcTimeout;
Object.values(inputs).forEach(input => {
  input.addEventListener('input', () => {
    clearTimeout(calcTimeout);
    calcTimeout = setTimeout(calcular, 300);
  });
  input.addEventListener('change', calcular);
});

btnCalcular.addEventListener('click', calcular);

// Inicialização
loadState();
calcular();

// Atualizar URL ao mudar (sem reload)
Object.values(inputs).forEach(input => {
  input.addEventListener('change', () => {
    const params = new URLSearchParams();
    for (const [key, inp] of Object.entries(inputs)) {
      params.set(key, inp.value);
    }
    const newUrl = `${window.location.pathname}?${params.toString()}`;
    window.history.replaceState({}, '', newUrl);
  });
});
</script>