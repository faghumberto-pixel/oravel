<span>Diária praticada própria (R$/8h)</span>
<input type="number" id="diariaPropria" step="10" min="0" value="550" style="font-family:inherit;padding:10px 12px;border:1px solid var(--cinza-claro);border-radius:8px;background:#fff;font-size:16px;width:100%;box-sizing:border-box">
</label>
<label class="form-conta" style="margin:0">
<span>Anos de projeto</span>
<input type="number" id="anosProjeto" step="1" min="1" max="10" value="5" style="font-family:inherit;padding:10px 12px;border:1px solid var(--cinza-claro);border-radius:8px;background:#fff;font-size:16px;width:100%;box-sizing:border-box">
</label>
</div>
</div>

<div style="background:#fff;border:1px solid var(--cinza-claro);border-radius:14px;padding:24px;margin-bottom:16px">
