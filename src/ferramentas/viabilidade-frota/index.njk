<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
<label class="form-conta" style="margin:0">
<span>Categoria</span>
<select id="catFrota" style="font-family:inherit;padding:10px 12px;border:1px solid var(--cinza-claro);border-radius:8px;background:#fff;font-size:16px;width:100%;box-sizing:border-box">
<option value="escavadeira">Escavadeira 20-25t</option>
<option value="pacarreira">Pá Carregadeira 3-4m³</option>
<option value="motoniveladora">Motoniveladora 140-160hp</option>
<option value="rolo">Rolo Compactador 10-12t</option>
<option value="plataforma">Plataforma Tesoura 10-12m</option>
<option value="guindaste">Guindaste 30-50t</option>
<option value="gerador">Gerador 100-200kVA</option>
<option value="compressor">Compressor 150-250pcm</option>
<option value="outro">Outro</option>
</select>
</label>
<label class="form-conta" style="margin:0">
<span>Quantidade de unidades</span>
<input type="number" id="qtdUnidades" step="1" min="1" value="3" style="font-family:inherit;padding:10px 12px;border:1px solid var(--cinza-claro);border-radius:8px;background:#fff;font-size:16px;width:100%;box-sizing:border-box">
</label>
</div>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px">
<label class="form-conta" style="margin:0">
<span>Modalidade</span>
<select id="modalidadeFrota" style="font-family:inherit;padding:10px 12px;border:1px solid var(--cinza-claro);border-radius:8px;background:#fff;font-size:16px;width:100%;box-sizing:border-box">
<option value="compra">Compra à vista</option>
<option value="financiamento">Financiamento (CDC/Finame)</option>
<option value="consorcio">Consórcio</option>
<option value="aluguel">Aluguel (Rental) longo prazo</option>
<option value="sale-leaseback">Sale & Leaseback</option>
</select>
</label>
<label class="form-conta" style="margin:0">
<span>Novo ou Usado</span>
<select id="condFrota" style="font-family:inherit;padding:10px 12px;border:1px solid var(--cinza-claro);border-radius:8px;background:#fff;font-size:16px;width:100%;box-sizing:border-box">
<option value="novo">Novo</option>
<option value="usado">Usado (2-4 anos)</option>
</select>
</label>
</div>
</div>

<div style="background:#fff;border:1px solid var(--cinza-claro);border-radius:14px;padding:24px;margin-bottom:16px">
