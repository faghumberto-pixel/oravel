<label class="form-conta" style="margin:0">
<span>Horas trabalhadas/unidade/ano</span>
<input type="number" id="hrsAnoUnit" step="100" min="500" max="4000" value="1800" style="font-family:inherit;padding:10px 12px;border:1px solid var(--cinza-claro);border-radius:8px;background:#fff;font-size:16px;width:100%;box-sizing:border-box">
</label>
<label class="form-conta" style="margin:0">
<span>Taxa de ocupação esperada (%)</span>
<input type="number" id="taxOcupExp" step="1" min="0" max="100" value="75" style="font-family:inherit;padding:10px 12px;border:1px solid var(--cinza-claro);border-radius:8px;background:#fff;font-size:16px;width:100%;box-sizing:border-box">
</label>
</div>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px">
