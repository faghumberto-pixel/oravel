<button class="btn btn-outline" id="btnCopiarLinkFrota" style="background:transparent;color:var(--texto-escuro);border:2px solid var(--texto-escuro);padding:12px 20px;border-radius:8px;cursor:pointer;font-family:inherit;font-size:14px">Copiar link</button>
<button class="btn" id="btnExportarCSVFrota" style="background:var(--azul-petroleo);color:#fff;padding:12px 20px;border-radius:8px;border:0;cursor:pointer;font-family:inherit;font-size:14px">Exportar CSV</button>
</div>

<div class="muted-sm" style="margin-top:16px">
<strong>Versão:</strong> v1.0 — <strong>Revisão técnica:</strong> Gil Montevaz, administrador (Consultor Gestão/Operação) — <strong>Última atualização:</strong> {{ "now" | dateISO | dateBr }} — <strong>Próxima revisão:</strong> trimestral
</div>
</div>

</div>
</section>

<script>
// ===== CALCULADORA VIABILIDADE FROTA v1.0 =====

const DEFAULTS_FROTA = {
  catFrota: 'escavadeira',
  qtdUnidades: 3,
  modalidadeFrota: 'financiamento',
  condFrota: 'novo',
  precoUnit: 350000,
  vrUnit: 60000,
  diariaMercado: 500,
  custoOpUnit: 85000,
  hrsAnoUnit: 1800,
  taxOcupExp: 75,
  diariaPropria: 550,
  anosProjeto: 5,
  entradaPct: 30,
  taxaFinFrota: 12.5,
  prazoFinFrota: 60,
  carenciaFrota: 0,
  waccFrota: 14.5,
  irEfetivo: 15,
  deprFiscal: 10,
  dscrMin: 1.3
};

const inputs = {};
Object.keys(DEFAULTS_FROTA).forEach(key => {
  inputs[key] = document.getElementById(key);
});

const fmtBRL = (v) => new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL', minimumFractionDigits: 0 }).format(Math.round(v));
const fmtBRL2 = (v) => new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL', minimumFractionDigits: 2 }).format(v);
const fmtNum = (v, d = 0) => new Intl.NumberFormat('pt-BR', { minimumFractionDigits: d, maximumFractionDigits: d }).format(v);
const fmtPct = (v) => new Intl.NumberFormat('pt-BR', { style: 'percent', minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(v / 100);

function loadState() {
  const params = new URLSearchParams(window.location.search);
  let fromUrl = false;
  for (const [key, input] of Object.entries(inputs)) {
    const urlVal = params.get(key);
    if (urlVal !== null) { input.value = urlVal; fromUrl = true; }
  }
  if (!fromUrl) {
    for (const [key, input] of Object.entries(inputs)) {
      const saved = localStorage.getItem(`calc_frota_${key}`);
      if (saved !== null) input.value = saved;
    }
  }
}

function saveState() {
  for (const [key, input] of Object.entries(inputs)) {
    localStorage.setItem(`calc_frota_${key}`, input.value);
  }
}

function pmt(rate, nper, pv) {
  if (rate === 0) return pv / nper;
  const r = rate / 100 / 12;
  return pv * r * Math.pow(1 + r, nper) / (Math.pow(1 + r, nper) - 1);
}

function calcularModalidade(v, modalidade) {
  const qtd = v.qtdUnidades;
  const preco = v.precoUnit;
  const vr = v.vrUnit;
  const custoOp = v.custoOpUnit;
  const hrsAno = v.hrsAnoUnit;
  const ocup = v.taxOcupExp / 100;
  const diaria = v.diariaPropria;
  const anos = v.anosProjeto;
  const wacc = v.waccFrota / 100;
  const ir = v.irEfetivo / 100;
  const deprAnos = v.deprFiscal;

  let investInicial = 0;
  let fluxoFinanc = [];
  let valorLivro = preco * qtd;

  if (modalidade === 'compra') {
    investInicial = preco * qtd;
  } else if (modalidade === 'financiamento') {
    const financiado = preco * qtd * (1 - v.entradaPct / 100);
    investInicial = preco * qtd * (v.entradaPct / 100);
    const parcelaMensal = pmt(v.taxaFinFrota, v.prazoFinFrota, financiado);
    const parcelaAnual = parcelaMensal * 12;
    let saldo = financiado;
    for (let a = 1; a <= anos; a++) {
      let princ = 0, juros = 0;
      if (a > v.carenciaFrota / 12 && saldo > 0) {
        juros = saldo * (v.taxaFinFrota / 100);
        princ = Math.min(parcelaAnual - juros, saldo);
        saldo -= princ;
      }
      fluxoFinanc[a] = { princ, juros, total: princ + juros };
    }
  } else if (modalidade === 'consorcio') {
    // Consórcio: lance ou sorteio - simplificado como parcela mensal sem juros, com taxa adm
    const taxaAdm = 0.18; // 18% total
    const totalConsorcio = preco * qtd * (1 + taxaAdm);
    const parcelaMensal = totalConsorcio / (v.prazoFinFrota || 80);
    const parcelaAnual = parcelaMensal * 12;
    investInicial = 0; // sem entrada
    for (let a = 1; a <= anos; a++) {
      fluxoFinanc[a] = { princ: parcelaAnual, juros: 0, total: parcelaAnual };
    }
  } else if (modalidade === 'aluguel') {
    investInicial = 0;
    const custoAluguelAnual = (v.diariaMercado / 8) * hrsAno * qtd;
    for (let a = 1; a <= anos; a++) {
      fluxoFinanc[a] = { princ: 0, juros: 0, total: custoAluguelAnual };
    }
    // Para aluguel, custo operacional só operador + combustível (assume 60% do custoOp)
    custoOp = v.custoOpUnit * 0.6;
  } else if (modalidade === 'sale-leaseback') {
    // Vende frota existente e aluga de volta - aqui modela como aluguel com entrada negativa (recebe venda)
    investInicial = -vr * qtd; // recebe valor residual
    const custoAluguelAnual = (v.diariaMercado / 8) * hrsAno * qtd * 1.15; // leaseback costuma ser +15%
    for (let a = 1; a <= anos; a++) {
      fluxoFinanc[a] = { princ: 0, juros: 0, total: custoAluguelAnual };
    }
    custoOp = v.custoOpUnit * 0.6;
  }

  // Receita anual
  const receitaAnual = (diaria / 8) * hrsAno * ocup * qtd;
  const custoOpAnual = custoOp * qtd;
  const depreciacaoAnual = (preco * qtd - vr * qtd) / deprAnos;

  // Fluxo de caixa
  let vpl = -investInicial;
  let tirFluxo = [investInicial]; // positivo = saída
  const fluxoAnual = [];
  let vplAcum = -investInicial;
  let dscrSum = 0, dscrCount = 0;

  for (let a = 1; a <= anos; a++) {
    const fin = fluxoFinanc[a] || { total: 0, juros: 0, princ: 0 };
    const ebitda = receitaAnual - custoOpAnual;
    const ebit = ebitda - depreciacaoAnual;
    const irValor = Math.max(0, ebit) * ir;
    const fcl = ebitda - fin.total - irValor;

    const vpFcl = fcl / Math.pow(1 + wacc, a);
    vpl += vpFcl;
    vplAcum += vpFcl;
    tirFluxo.push(-fcl); // FCL é entrada

    const dscr = fin.total > 0 ? ebitda / fin.total : 99;
    if (fin.total > 0) { dscrSum += dscr; dscrCount++; }

    fluxoAnual.push({
      ano: a, receita: receitaAnual, custoOp: custoOpAnual,
      finTotal: fin.total, finJuros: fin.juros, finPrinc: fin.princ,
      depreciacao: depreciacaoAnual, ebitda, ebit, ir: irValor, fcl, vpFcl, vplAcum, dscr
    });
  }

  // Valor residual no final
  const vpVr = (vr * qtd) / Math.pow(1 + wacc, anos);
  vpl += vpVr;
  tirFluxo[tirFluxo.length - 1] += vr * qtd;

  // TIR
  let tir = 0;
  {
    let low = -0.5, high = 3.0;
    for (let i = 0; i < 60; i++) {
      const mid = (low + high) / 2;
      let npv = 0;
      for (let t = 0; t < tirFluxo.length; t++) {
        npv += tirFluxo[t] / Math.pow(1 + mid, t);
      }
      if (npv > 0) low = mid; else high = mid;
    }
    tir = (low + high) / 2;
  }

  // Payback descontado
  let payback = anos;
  for (let a = 0; a < fluxoAnual.length; a++) {
    if (fluxoAnual[a].vplAcum >= 0) {
      payback = a + (a > 0 ? (fluxoAnual[a].vplAcum - fluxoAnual[a].vpFcl) / fluxoAnual[a].vpFcl : 0);
      break;
    }
  }

  const dscrMedio = dscrCount > 0 ? dscrSum / dscrCount : 99;
  const fclMedio = fluxoAnual.reduce((s, f) => s + f.fcl, 0) / anos;
  const pontoEquil = custoOpAnual > 0 ? (custoOpAnual + (fluxoFinanc[1]?.total || 0)) / ((diaria/8) * hrsAno * qtd) * 100 : 0;

  // Status
  let status = '', statusClass = '';
  if (vpl > 0 && tir > wacc && dscrMedio >= v.dscrMin) {
    status = '✅ VIÁVEL — VPL positivo, TIR > WACC, DSCR adequado. Projeto cria valor para o acionista.';
    statusClass = 'background:#e7f1ef;border-color:#0b5f57';
  } else if (vpl > 0 && tir > wacc) {
    status = '⚠️ VIÁVEL COM RESSALVA — VPL e TIR ok, mas DSCR abaixo do mínimo (' + fmtNum(dscrMedio, 2) + ' < ' + fmtNum(v.dscrMin, 2) + '). Requer estrutura de financiamento mais longa ou maior entrada.';
    statusClass = 'background:#fef3e7;border-color:#f59e0b';
  } else if (vpl > 0) {
    status = '⚠️ MARGINAL — VPL positivo mas TIR < WACC (' + fmtNum(tir*100,1) + '% < ' + fmtNum(wacc*100,1) + '%). Projeto destrói valor econômico. Considere apenas se estratégico.';
    statusClass = 'background:#fef3e7;border-color:#f59e0b';
  } else {
    status = '❌ NÃO VIÁVEL — VPL negativo (' + fmtBRL(vpl) + '). Projeto destrói valor. Não recomendado nas condições atuais.';
    statusClass = 'background:#fef3e7;border-color:#9a3412';
  }

  return { vpl, tir, payback, dscrMedio, fclMedio, pontoEquil, investInicial, fluxoAnual, status, statusClass, receitaAnual, custoOpAnual };
}

function calcular() {
  const v = {};
  for (const [key, input] of Object.entries(inputs)) {
    const val = input.value;
    v[key] = isNaN(parseFloat(val)) ? val : parseFloat(val);
  }

  if (v.qtdUnidades <= 0) { alert('Quantidade > 0'); return; }
  if (v.precoUnit <= 0) { alert('Preço unitário > 0'); return; }
  if (v.anosProjeto <= 0) { alert('Anos de projeto > 0'); return; }

  // Modalidade selecionada
  const res = calcularModalidade(v, v.modalidadeFrota);

  // Stress test
  const cenarios = [
    { nome: 'Base', ocup: v.taxOcupExp, diaria: v.diariaPropria, custoOp: 1, wacc: v.waccFrota },
    { nome: 'Otimista (+10pp ocup, +5% diária)', ocup: Math.min(95, v.taxOcupExp + 10), diaria: v.diariaPropria * 1.05, custoOp: 0.95, wacc: v.waccFrota },
    { nome: 'Conservador (-10pp ocup, -5% diária)', ocup: Math.max(40, v.taxOcupExp - 10), diaria: v.diariaPropria * 0.95, custoOp: 1.1, wacc: v.waccFrota },
    { nome: 'Baixa demanda (-20pp ocup)', ocup: Math.max(30, v.taxOcupExp - 20), diaria: v.diariaPropria, custoOp: 1, wacc: v.waccFrota },
    { nome: 'Custo operacional +20%', ocup: v.taxOcupExp, diaria: v.diariaPropria, custoOp: 1.2, wacc: v.waccFrota },
    { nome: 'WACC +3pp', ocup: v.taxOcupExp, diaria: v.diariaPropria, custoOp: 1, wacc: v.waccFrota + 3 },
    { nome: 'Crise combinada (-15pp ocup, +15% custo, WACC+2pp)', ocup: Math.max(35, v.taxOcupExp - 15), diaria: v.diariaPropria * 0.98, custoOp: 1.15, wacc: v.waccFrota + 2 },
  ];

  const stressResultados = cenarios.map(c => {
    const vMod = { ...v, taxOcupExp: c.ocup, diariaPropria: c.diaria, custoOpUnit: v.custoOpUnit * c.custoOp, waccFrota: c.wacc };
    const r = calcularModalidade(vMod, v.modalidadeFrota);
    const viavel = r.vpl > 0 && r.tir > (c.wacc/100) && r.dscrMedio >= v.dscrMin;
    return { ...c, vpl: r.vpl, tir: r.tir, dscr: r.dscrMedio, viavel };
  });

  // Comparativo modalidades
  const modalidades = ['compra', 'financiamento', 'consorcio', 'aluguel', 'sale-leaseback'];
  const modalidadeLabels = {
    compra: 'Compra à vista',
    financiamento: 'Financiamento (CDC/Finame)',
    consorcio: 'Consórcio',
    aluguel: 'Aluguel longo prazo',
    'sale-leaseback': 'Sale & Leaseback'
  };
  const modalidadeResults = modalidades.map(m => {
    const r = calcularModalidade(v, m);
    const viavel = r.vpl > 0 && r.tir > (v.waccFrota/100) && r.dscrMedio >= v.dscrMin;
    let rec = '';
    if (viavel) rec = '✅ Recomendado';
    else if (r.vpl > 0) rec = '⚠️ Viável c/ ressalva';
    else rec = '❌ Não recomendado';
    return { label: modalidadeLabels[m], ...r, viavel, rec };
  });

  // Render
  document.getElementById('resQtdFrota').textContent = v.qtdUnidades;
  document.getElementById('resCatFrota').textContent = v.catFrota.charAt(0).toUpperCase() + v.catFrota.slice(1) + 's';
  document.getElementById('resVplFrota').textContent = fmtBRL(res.vpl);
  document.getElementById('resTirFrota').textContent = fmtNum(res.tir * 100, 1) + '%';
  document.getElementById('resPaybackFrota').textContent = fmtNum(res.payback, 1) + ' anos';
  document.getElementById('resDscrFrota').textContent = fmtNum(res.dscrMedio, 2);
  document.getElementById('resPontoEquil').textContent = fmtNum(res.pontoEquil, 1) + '%';
  document.getElementById('resInvestTotal').textContent = fmtBRL(res.investInicial);
  document.getElementById('resFluxoCaixaLivre').textContent = fmtBRL(res.fclMedio);

  document.getElementById('statusProjeto').setAttribute('style', 'padding:16px;border-radius:8px;' + res.statusClass);
  document.getElementById('statusTexto').innerHTML = res.status;

  const tb = document.getElementById('tbodyFluxoFrota');
  tb.innerHTML = res.fluxoAnual.map(f => `
    <tr style="border-bottom:1px solid #f0efe9">
      <td style="padding:8px 10px;color:var(--texto-escuro)">${f.ano}</td>
      <td style="padding:8px 10px;text-align:right;color:var(--azul-petroleo)">${fmtBRL(f.receita)}</td>
      <td style="padding:8px 10px;text-align:right;color:#9a3412">${fmtBRL(f.custoOp)}</td>
      <td style="padding:8px 10px;text-align:right;color:#b45309">${fmtBRL(f.finTotal)}</td>
      <td style="padding:8px 10px;text-align:right;color:var(--texto-secundario)">${fmtBRL(f.depreciacao)}</td>
      <td style="padding:8px 10px;text-align:right;color:var(--texto-escuro);font-weight:600">${fmtBRL(f.ebitda)}</td>
      <td style="padding:8px 10px;text-align:right;color:#9a3412">${fmtBRL(f.ir)}</td>
      <td style="padding:8px 10px;text-align:right;color:var(--azul-petroleo);font-weight:600">${fmtBRL(f.fcl)}</td>
      <td style="padding:8px 10px;text-align:right;color:var(--azul-petroleo)">${fmtBRL(f.vpFcl)}</td>
      <td style="padding:8px 10px;text-align:right;color:var(--texto-escuro);font-weight:600">${fmtBRL(f.vplAcum)}</td>
    </tr>
  `).join('');

  const tb2 = document.getElementById('tbodyStressFrota');
  tb2.innerHTML = stressResultados.map(c => `
    <tr style="border-bottom:1px solid #f0efe9 ${c.nome === 'Base' ? ';font-weight:600' : ''}">
      <td style="padding:10px 12px;color:var(--texto-escuro)">${c.nome}</td>
      <td style="padding:10px 12px;text-align:right;color:var(--texto-secundario)">${fmtNum(c.ocup, 0)}%</td>
      <td style="padding:10px 12px;text-align:right;color:var(--texto-secundario)">${fmtBRL(c.diaria)}</td>
      <td style="padding:10px 12px;text-align:right;color:var(--texto-secundario)">${fmtNum(c.custoOp * 100, 0)}%</td>
      <td style="padding:10px 12px;text-align:right;color:var(--texto-secundario)">${fmtNum(c.wacc, 1)}%</td>
      <td style="padding:10px 12px;text-align:right;color:${c.vpl >= 0 ? 'var(--azul-petroleo)' : '#9a3412'};font-weight:600">${fmtBRL(c.vpl)}</td>
      <td style="padding:10px 12px;text-align:right;color:${c.tir >= c.wacc/100 ? 'var(--azul-petroleo)' : '#9a3412'};font-weight:600">${fmtNum(c.tir * 100, 1)}%</td>
      <td style="padding:10px 12px;text-align:right;color:${c.dscr >= v.dscrMin ? 'var(--azul-petroleo)' : '#9a3412'};font-weight:600">${fmtNum(c.dscr, 2)}</td>
      <td style="padding:10px 12px;text-align:center;color:${c.viavel ? 'var(--azul-petroleo)' : '#9a3412'};font-weight:600">${c.viavel ? '✅ Sim' : '❌ Não'}</td>
    </tr>
  `).join('');

  const tb3 = document.getElementById('tbodyModalidades');
  tb3.innerHTML = modalidadeResults.map(m => `
    <tr style="border-bottom:1px solid #f0efe9 ${m.label === modalidadeLabels[v.modalidadeFrota] ? ';font-weight:600' : ''}">
      <td style="padding:10px 12px;color:var(--texto-escuro)">${m.label}</td>
      <td style="padding:10px 12px;text-align:right;color:var(--texto-secundario)">${fmtBRL(m.investInicial)}</td>
      <td style="padding:10px 12px;text-align:right;color:${m.vpl >= 0 ? 'var(--azul-petroleo)' : '#9a3412'};font-weight:600">${fmtBRL(m.vpl)}</td>
      <td style="padding:10px 12px;text-align:right;color:${m.tir >= v.waccFrota/100 ? 'var(--azul-petroleo)' : '#9a3412'};font-weight:600">${fmtNum(m.tir * 100, 1)}%</td>
      <td style="padding:10px 12px;text-align:right;color:var(--texto-secundario)">${isFinite(m.payback) ? fmtNum(m.payback, 1) + 'a' : '—'}</td>
      <td style="padding:10px 12px;text-align:right;color:${m.dscrMedio >= v.dscrMin ? 'var(--azul-petroleo)' : '#9a3412'};font-weight:600">${fmtNum(m.dscrMedio, 2)}</td>
      <td style="padding:10px 12px;text-align:center;color:${m.viavel ? 'var(--azul-petroleo)' : '#9a3412'};font-weight:600">${m.rec}</td>
    </tr>
  `).join('');

  document.getElementById('resultadosFrota').style.display = 'block';
  saveState();
}

document.getElementById('btnCalcFrota').addEventListener('click', calcular);
document.getElementById('btnResetFrota').addEventListener('click', () => {
  for (const [key, input] of Object.entries(inputs)) { input.value = DEFAULTS_FROTA[key]; }
  localStorage.clear();
  document.getElementById('resultadosFrota').style.display = 'none';
});

document.getElementById('btnCopiarLinkFrota').addEventListener('click', () => {
  const params = new URLSearchParams();
  for (const [key, input] of Object.entries(inputs)) { params.set(key, input.value); }
  navigator.clipboard.writeText(`${window.location.origin}${window.location.pathname}?${params.toString()}`).then(() => {
    const btn = document.getElementById('btnCopiarLinkFrota');
    const orig = btn.textContent; btn.textContent = 'Copiado!'; setTimeout(() => btn.textContent = orig, 2000);
  });
});

document.getElementById('btnExportarCSVFrota').addEventListener('click', () => {
  const linhas = [
    ['Parâmetro', 'Valor'],
    ['Categoria', inputs.catFrota.value],
    ['Quantidade', inputs.qtdUnidades.value],
    ['Modalidade', inputs.modalidadeFrota.value],
    ['Condição', inputs.condFrota.value],
    ['Preço unitário', inputs.precoUnit.value],
    ['Valor residual unit.', inputs.vrUnit.value],
    ['Diária mercado', inputs.diariaMercado.value],
    ['Custo op. unit/ano', inputs.custoOpUnit.value],
    ['Horas/ano/unidade', inputs.hrsAnoUnit.value],
    ['Taxa ocup. esperada', inputs.taxOcupExp.value],
    ['Diária própria', inputs.diariaPropria.value],
    ['Anos projeto', inputs.anosProjeto.value],
    ['Entrada %', inputs.entradaPct.value],
    ['Taxa financiamento', inputs.taxaFinFrota.value],
    ['Prazo financiamento', inputs.prazoFinFrota.value],
    ['Carência', inputs.carenciaFrota.value],
    ['WACC', inputs.waccFrota.value],
    ['IR/CSLL efetivo', inputs.irEfetivo.value],
    ['Depreciação fiscal (anos)', inputs.deprFiscal.value],
    ['DSCR mínimo', inputs.dscrMin.value],
    ['', ''],
    ['Resultado', 'Valor'],
    ['VPL', document.getElementById('resVplFrota').textContent],
    ['TIR', document.getElementById('resTirFrota').textContent],
    ['Payback Descontado', document.getElementById('resPaybackFrota').textContent],
    ['DSCR Médio', document.getElementById('resDscrFrota').textContent],
    ['Ocupação Break-even', document.getElementById('resPontoEquil').textContent],
    ['Investimento Total', document.getElementById('resInvestTotal').textContent],
    ['FCL Médio/Ano', document.getElementById('resFluxoCaixaLivre').textContent],
  ];
  const csv = linhas.map(r => r.map(c => `"${c}"`).join(',')).join('\n');
  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
  const link = document.createElement('a');
  link.href = URL.createObjectURL(blob);
  link.download = `viabilidade-frota-${inputs.catFrota.value}-${new Date().toISOString().split('T')[0]}.csv`;
  link.click();
});

let timeout;
Object.values(inputs).forEach(input => {
  input.addEventListener('input', () => { clearTimeout(timeout); timeout = setTimeout(calcular, 300); });
  input.addEventListener('change', calcular);
});

Object.values(inputs).forEach(input => {
  input.addEventListener('change', () => {
    const params = new URLSearchParams();
    for (const [key, inp] of Object.entries(inputs)) { params.set(key, inp.value); }
    window.history.replaceState({}, '', `${window.location.pathname}?${params.toString()}`);
  });
});

loadState();
calcular();
</script>