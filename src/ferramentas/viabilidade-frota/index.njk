<button class="btn btn-outline" id="btnResetFrota" style="background:transparent;color:var(--texto-escuro);border:2px solid var(--texto-escuro);padding:14px 28px;border-radius:8px;cursor:pointer;font-family:inherit;font-size:16px;min-height:52px">Resetar</button>
<a href="/ferramentas/" class="btn btn-outline">← Voltar</a>
