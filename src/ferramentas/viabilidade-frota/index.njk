<input type="number" id="prazoFinFrota" step="1" min="1" max="120" value="60" style="font-family:inherit;padding:10px 12px;border:1px solid var(--cinza-claro);border-radius:8px;background:#fff;font-size:16px;width:100%;box-sizing:border-box">
