<script>
// ===== CALCULADORA ROI MANUTENÇÃO v1.0 =====

const DEFAULTS_ROI = {
  numEquip: 15,
  horasMesEquip: 180,
  diariaMedia: 500,
  taxaOcupMedia: 70,
  corrAtual: 450000,
  prevAtual: 120000,
  pecasEmergAtual: 180000,
  maoObraEmergAtual: 90000,
  falhasAnoAtual: 60,
  mttrAtual: 8,
  tipoPrograma: 'preventiva',
  capexInicial: 150000,
  opexAnual: 80000,
  vidaPrograma: 5,
  redFalhas: 45,
  redMttr: 30,
  redPecas: 40,
  redMaoObra: 35,
  aumVidaUtil: 15,
  waccRoi: 14.5
};

const inputs = {};
Object.keys(DEFAULTS_ROI).forEach(key => {
  inputs[key] = document.getElementById(key);
});

const fmtBRL = (v) => new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL', minimumFractionDigits: 0 }).format(Math.round(v));
const fmtBRL2 = (v) => new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL', minimumFractionDigits: 2 }).format(v);
const fmtNum = (v, d = 0) => new Intl.NumberFormat('pt-BR', { minimumFractionDigits: d, maximumFractionDigits: d }).format(v);
const fmtPct = (v) => new Intl.NumberFormat('pt-BR', { style: 'percent', minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(v / 100);

function loadState() {
  const params = new URLSearchParams(window.location.search);
  let fromUrl = false;
  for (const [key, input] of Object.entries(inputs)) {
    const urlVal = params.get(key);
    if (urlVal !== null) { input.value = urlVal; fromUrl = true; }
  }
  if (!fromUrl) {
    for (const [key, input] of Object.entries(inputs)) {
      const saved = localStorage.getItem(`calc_roi_${key}`);
      if (saved !== null) input.value = saved;
    }
  }
}

function saveState() {
  for (const [key, input] of Object.entries(inputs)) {
    localStorage.setItem(`calc_roi_${key}`, input.value);
  }
}

function calcular() {
  const v = {};
  for (const [key, input] of Object.entries(inputs)) {
    const val = input.value;
    v[key] = isNaN(parseFloat(val)) ? val : parseFloat(val);
  }

  if (v.numEquip <= 0) { alert('Nº equipamentos > 0'); return; }
  if (v.vidaPrograma <= 0) { alert('Vida programa > 0'); return; }

  // Custos atuais anuais
  const custoTotalAtual = v.corrAtual + v.prevAtual + v.pecasEmergAtual + v.maoObraEmergAtual;

  // Ganhos anuais
  const economiaCorretiva = v.corrAtual * (v.redFalhas / 100);
  const economiaPecas = v.pecasEmergAtual * (v.redPecas / 100);
  const economiaMaoObra = v.maoObraEmergAtual * (v.redMaoObra / 100);
  const economiaTotalBruta = economiaCorretiva + economiaPecas + economiaMaoObra;

  // Custo do programa
  const custoProgramaAnual = v.opexAnual;
  const economiaLiquidaAnual = economiaTotalBruta - custoProgramaAnual;

  // Receita adicional por disponibilidade
  const horasParadasAtualAno = v.falhasAnoAtual * v.mttrAtual;
  const falhasNovo = v.falhasAnoAtual * (1 - v.redFalhas / 100);
  const mttrNovo = v.mttrAtual * (1 - v.redMttr / 100);
  const horasParadasNovaAno = falhasNovo * mttrNovo;
  const horasRecuperadasAno = horasParadasAtualAno - horasParadasNovaAno;
  const receitaHora = v.diariaMedia / 8;
  const receitaAdicionalAnual = horasRecuperadasAno * receitaHora * (v.taxaOcupMedia / 100) * v.numEquip;

  // Benefício extensão vida útil (valor residual)
  const valorFrota = v.numEquip * 300000; // estimativa média R$ 300k/equip
  const valorVidaUtilAnual = valorFrota * (v.aumVidaUtil / 100) / v.vidaPrograma; // simplificado

  // Benefício total anual
  const beneficioTotalAnual = economiaLiquidaAnual + receitaAdicionalAnual + valorVidaUtilAnual;

  // Payback
  const paybackMeses = beneficioTotalAnual > 0 ? (v.capexInicial / beneficioTotalAnual) * 12 : Infinity;

  // ROI Anualizado
  const roiAnual = v.capexInicial > 0 ? (beneficioTotalAnual / v.capexInicial) * 100 : 0;

  // NPV
  let npv = -v.capexInicial;
  let fluxoAcumulado = -v.capexInicial;
  const fluxoCaixa = [];
  for (let ano = 1; ano <= v.vidaPrograma; ano++) {
    const fluxoAno = beneficioTotalAnual - v.opexAnual; // OPEX já está na economia líquida, mas vamos separar
    // Na verdade: economiaLiquidaAnual já subtrai OPEX. beneficioTotalAnual = economiaLiquidaAnual + receitaAdicional + valorVidaUtil
    const fluxoLiquido = beneficioTotalAnual;
    const vp = fluxoLiquido / Math.pow(1 + v.waccRoi / 100, ano);
    fluxoAcumulado += fluxoLiquido;
    npv += vp;
    fluxoCaixa.push({ ano, capex: ano === 1 ? v.capexInicial : 0, opex: v.opexAnual, economiaBruta: economiaTotalBruta + receitaAdicionalAnual + valorVidaUtilAnual, economiaLiquida: fluxoLiquido, acumulado: fluxoAcumulado, vp });
  }

  // Ganho disponibilidade
  const horasTotalAno = v.numEquip * v.horasMesEquip * 12;
  const dispAtual = (horasTotalAno - horasParadasAtualAno) / horasTotalAno * 100;
  const dispNova = (horasTotalAno - horasParadasNovaAno) / horasTotalAno * 100;
  const ganhoDisp = dispNova - dispAtual;

  // Falhas evitadas
  const falhasEvitadas = v.falhasAnoAtual - falhasNovo;

  // Cenários de sensibilidade
  const cenarios = [
    { nome: 'Base', rf: v.redFalhas, rm: v.redMttr, capex: v.capexInicial, opex: v.opexAnual },
    { nome: 'Conservador (-10pp falhas, -5pp MTTR)', rf: v.redFalhas - 10, rm: v.redMttr - 5, capex: v.capexInicial, opex: v.opexAnual },
    { nome: 'Otimista (+10pp falhas, +5pp MTTR)', rf: v.redFalhas + 10, rm: v.redMttr + 5, capex: v.capexInicial, opex: v.opexAnual },
    { nome: 'CAPEX +30%', rf: v.redFalhas, rm: v.redMttr, capex: v.capexInicial * 1.3, opex: v.opexAnual },
    { nome: 'OPEX +50%', rf: v.redFalhas, rm: v.redMttr, capex: v.capexInicial, opex: v.opexAnual * 1.5 },
    { nome: 'WACC +3pp', rf: v.redFalhas, rm: v.redMttr, capex: v.capexInicial, opex: v.opexAnual, wacc: v.waccRoi + 3 },
  ];

  const cenarioResultados = cenarios.map(c => {
    const wacc = c.wacc || v.waccRoi;
    const ecCorr = v.corrAtual * (c.rf / 100);
    const ecPec = v.pecasEmergAtual * (v.redPecas / 100);
    const ecMO = v.maoObraEmergAtual * (v.redMaoObra / 100);
    const ecBruta = ecCorr + ecPec + ecMO;
    const ecLiq = ecBruta - c.opex;
    const falhasN = v.falhasAnoAtual * (1 - c.rf / 100);
    const mttrN = v.mttrAtual * (1 - c.rm / 100);
    const hrParAt = v.falhasAnoAtual * v.mttrAtual;
    const hrParNv = falhasN * mttrN;
    const hrRec = hrParAt - hrParNv;
    const recAd = hrRec * receitaHora * (v.taxaOcupMedia / 100) * v.numEquip;
    const valVU = valorFrota * (v.aumVidaUtil / 100) / v.vidaPrograma;
    const benTotal = ecLiq + recAd + valVU;
    const payb = benTotal > 0 ? (c.capex / benTotal) * 12 : Infinity;
    let npvC = -c.capex;
    for (let a = 1; a <= v.vidaPrograma; a++) {
      npvC += benTotal / Math.pow(1 + wacc / 100, a);
    }
    return { ...c, npv: npvC, payback: payb };
  });

  // Render
  document.getElementById('resEconomiaAnual').textContent = fmtBRL(beneficioTotalAnual);
  document.getElementById('resPaybackRoi').textContent = isFinite(paybackMeses) ? fmtNum(paybackMeses, 1) + ' meses' : '—';
  document.getElementById('resNpv').textContent = fmtBRL(npv);
  document.getElementById('resROI').textContent = fmtNum(roiAnual, 1) + '%';
  document.getElementById('resDispGanho').textContent = fmtNum(ganhoDisp, 1) + ' pp';
  document.getElementById('resFalhasEvitadas').textContent = fmtNum(falhasEvitadas, 0);
  document.getElementById('resVidaUtilGanho').textContent = fmtNum(v.aumVidaUtil, 0) + '%';

  document.getElementById('breakdownRoi').innerHTML = [
    { label: 'Economia corretiva (falhas ↓)', value: economiaCorretiva, cor: '#0b5f57' },
    { label: 'Economia peças emergenciais ↓', value: economiaPecas, cor: '#0b5f57' },
    { label: 'Economia mão de obra emerg. ↓', value: economiaMaoObra, cor: '#0b5f57' },
    { label: '<strong>Economia Bruta Manutenção</strong>', value: economiaTotalBruta, subtotal: true },
    { label: '(-) OPEX Programa', value: -custoProgramaAnual, cor: '#9a3412' },
    { label: '<strong>Economia Líquida Manutenção</strong>', value: economiaLiquidaAnual, subtotal: true, good: economiaLiquidaAnual > 0 },
    { label: 'Receita adicional (disp. ↑)', value: receitaAdicionalAnual, cor: '#0b5f57' },
    { label: 'Valor extensão vida útil', value: valorVidaUtilAnual, cor: '#f59e0b' },
    { label: '<strong>Benefício Total Anual</strong>', value: beneficioTotalAnual, total: true }
  ].map(b => `
    <div style="${b.total ? 'font-weight:700;color:var(--azul-petroleo);border-top:2px solid var(--azul-petroleo);padding-top:8px;margin-top:4px' : b.subtotal ? 'font-weight:600;color:var(--texto-escuro);border-top:1px solid var(--cinza-claro);padding-top:8px;margin-top:4px' : ''} ${b.good === false ? 'color:#9a3412' : ''}">
      <span>${b.label}</span>
      <span style="text-align:right;display:block;color:${b.cor || (b.value >= 0 ? 'var(--azul-petroleo)' : '#9a3412')}">${fmtBRL(b.value)}</span>
    </div>
  `).join('');

  const tb = document.getElementById('tbodyFluxoCaixa');
  tb.innerHTML = fluxoCaixa.map(f => `
    <tr style="border-bottom:1px solid #f0efe9 ${f.ano === 1 ? ';font-weight:600' : ''}">
      <td style="padding:10px 12px;color:var(--texto-escuro)">${f.ano}</td>
      <td style="padding:10px 12px;text-align:right;color:#9a3412">${fmtBRL(f.capex)}</td>
      <td style="padding:10px 12px;text-align:right;color:#9a3412">${fmtBRL(f.opex)}</td>
      <td style="padding:10px 12px;text-align:right;color:var(--azul-petroleo)">${fmtBRL(f.economiaBruta)}</td>
      <td style="padding:10px 12px;text-align:right;color:var(--texto-escuro);font-weight:600">${fmtBRL(f.economiaLiquida)}</td>
      <td style="padding:10px 12px;text-align:right;color:var(--texto-escuro);font-weight:600">${fmtBRL(f.acumulado)}</td>
      <td style="padding:10px 12px;text-align:right;color:var(--azul-petroleo)">${fmtBRL(f.vp)}</td>
    </tr>
  `).join('');

  const tb2 = document.getElementById('tbodyCenariosRoi');
  tb2.innerHTML = cenarioResultados.map(c => `
    <tr style="border-bottom:1px solid #f0efe9 ${c.nome === 'Base' ? ';font-weight:600' : ''}">
      <td style="padding:10px 12px;color:var(--texto-escuro)">${c.nome}</td>
      <td style="padding:10px 12px;text-align:right;color:var(--texto-secundario)">${fmtNum(c.rf, 0)}%</td>
      <td style="padding:10px 12px;text-align:right;color:var(--texto-secundario)">${fmtNum(c.rm, 0)}%</td>
      <td style="padding:10px 12px;text-align:right;color:var(--texto-secundario)">${fmtBRL(c.capex)}</td>
      <td style="padding:10px 12px;text-align:right;color:var(--texto-secundario)">${fmtBRL(c.opex)}</td>
      <td style="padding:10px 12px;text-align:right;color:var(--texto-escuro);font-weight:600">${fmtBRL(c.npv)}</td>
      <td style="padding:10px 12px;text-align:right;color:var(--texto-secundario);font-weight:600">${isFinite(c.payback) ? fmtNum(c.payback, 1) + 'm' : '—'}</td>
    </tr>
  `).join('');

  document.getElementById('resultadosRoi').style.display = 'block';
  saveState();
}

document.getElementById('btnCalcRoi').addEventListener('click', calcular);
document.getElementById('btnResetRoi').addEventListener('click', () => {
  for (const [key, input] of Object.entries(inputs)) { input.value = DEFAULTS_ROI[key]; }
  localStorage.clear();
  document.getElementById('resultadosRoi').style.display = 'none';
});

document.getElementById('btnCopiarLinkRoi').addEventListener('click', () => {
  const params = new URLSearchParams();
  for (const [key, input] of Object.entries(inputs)) { params.set(key, input.value); }
  navigator.clipboard.writeText(`${window.location.origin}${window.location.pathname}?${params.toString()}`).then(() => {
    const btn = document.getElementById('btnCopiarLinkRoi');
    const orig = btn.textContent; btn.textContent = 'Copiado!'; setTimeout(() => btn.textContent = orig, 2000);
  });
});

document.getElementById('btnExportarCSVRoi').addEventListener('click', () => {
  const linhas = [
    ['Parâmetro', 'Valor'],
    ['Nº equipamentos', inputs.numEquip.value],
    ['Horas/mês/equip', inputs.horasMesEquip.value],
    ['Diária média', inputs.diariaMedia.value],
    ['Taxa ocupação', inputs.taxaOcupMedia.value],
    ['Corretiva atual/ano', inputs.corrAtual.value],
    ['Preventiva atual/ano', inputs.prevAtual.value],
    ['Peças emergenciais/ano', inputs.pecasEmergAtual.value],
    ['Mão de obra emerg/ano', inputs.maoObraEmergAtual.value],
    ['Falhas/ano', inputs.falhasAnoAtual.value],
    ['MTTR atual', inputs.mttrAtual.value],
    ['Programa', inputs.tipoPrograma.value],
    ['CAPEX inicial', inputs.capexInicial.value],
    ['OPEX anual', inputs.opexAnual.value],
    ['Vida programa (anos)', inputs.vidaPrograma.value],
    ['Red. falhas (%)', inputs.redFalhas.value],
    ['Red. MTTR (%)', inputs.redMttr.value],
    ['Red. peças (%)', inputs.redPecas.value],
    ['Red. mão de obra (%)', inputs.redMaoObra.value],
    ['Aum. vida útil (%)', inputs.aumVidaUtil.value],
    ['WACC (%)', inputs.waccRoi.value],
    ['', ''],
    ['Resultado', 'Valor'],
    ['Economia Líquida Anual', document.getElementById('resEconomiaAnual').textContent],
    ['Payback', document.getElementById('resPaybackRoi').textContent],
    ['NPV (5 anos)', document.getElementById('resNpv').textContent],
    ['ROI Anualizado', document.getElementById('resROI').textContent],
    ['Ganho Disponibilidade', document.getElementById('resDispGanho').textContent],
    ['Falhas Evitadas/Ano', document.getElementById('resFalhasEvitadas').textContent],
    ['Extensão Vida Útil', document.getElementById('resVidaUtilGanho').textContent],
  ];
  const csv = linhas.map(r => r.map(c => `"${c}"`).join(',')).join('\n');
  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
  const link = document.createElement('a');
  link.href = URL.createObjectURL(blob);
  link.download = `roi-manutencao-${new Date().toISOString().split('T')[0]}.csv`;
  link.click();
});

let timeout;
Object.values(inputs).forEach(input => {
  input.addEventListener('input', () => { clearTimeout(timeout); timeout = setTimeout(calcular, 300); });
  input.addEventListener('change', calcular);
});

Object.values(inputs).forEach(input => {
  input.addEventListener('change', () => {
    const params = new URLSearchParams();
    for (const [key, inp] of Object.entries(inputs)) { params.set(key, inp.value); }
    window.history.replaceState({}, '', `${window.location.pathname}?${params.toString()}`);
  });
});

loadState();
calcular();
</script>