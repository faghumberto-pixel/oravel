</div>

<div class="muted-sm" style="margin-top:16px">
<strong>Versão:</strong> v1.0 — <strong>Revisão técnica:</strong> Gil Montevaz, administrador (Consultor Gestão/Operação) — <strong>Última atualização:</strong> {{ "now" | dateISO | dateBr }} — <strong>Próxima revisão:</strong> trimestral
</div>
</div>

</div>
</section>

<script>
// ===== CALCULADORA TCO v1.0 =====

const DEFAULTS_TCO = {
  codTco: 'EXC-001',
  catTco: 'escavadeira',
  modTco: 'Caterpillar 320D',
  condTco: 'novo',
  hrsUsadoTco: 3000,
  precoCompra: 350000,
  vidaUtilTco: 12000,
  valResidual: 50000,
  hrsAno: 2000,
  pctFinTco: 60,
  taxaFin: 13.5,
  prazoFin: 48,
  waccTco: 14.5,
  combAnual: 72000,
  opAnual: 54000,
  prevAnual: 15000,
  corrAnual: 25000,
  segAnual: 7800,
  rastAnual: 1800,
  pneusAnual: 12000,
  outrosAnual: 6000,
  diariaRental: 550,
  custTerc: 180
};

const inputs = {};
Object.keys(DEFAULTS_TCO).forEach(key => {
  inputs[key] = document.getElementById(key);
});

const fmtBRL = (v) => new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL', minimumFractionDigits: 0 }).format(Math.round(v));
const fmtBRL2 = (v) => new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL', minimumFractionDigits: 2 }).format(v);
const fmtNum = (v, d = 0) => new Intl.NumberFormat('pt-BR', { minimumFractionDigits: d, maximumFractionDigits: d }).format(v);
const fmtPct = (v) => new Intl.NumberFormat('pt-BR', { style: 'percent', minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(v / 100);

function loadState() {
  const params = new URLSearchParams(window.location.search);
  let fromUrl = false;
  for (const [key, input] of Object.entries(inputs)) {
    const urlVal = params.get(key);
    if (urlVal !== null) { input.value = urlVal; fromUrl = true; }
  }
  if (!fromUrl) {
    for (const [key, input] of Object.entries(inputs)) {
      const saved = localStorage.getItem(`calc_tco_${key}`);
      if (saved !== null) input.value = saved;
    }
  }
  toggleUsado();
}

function saveState() {
  for (const [key, input] of Object.entries(inputs)) {
    localStorage.setItem(`calc_tco_${key}`, input.value);
  }
}

function toggleUsado() {
  const linha = document.getElementById('linhaHorasUsado');
  if (inputs.condTco.value === 'usado') linha.style.display = 'grid'; else linha.style.display = 'none';
}
inputs.condTco.addEventListener('change', toggleUsado);

function pmt(rate, nper, pv) {
  if (rate === 0) return pv / nper;
  const r = rate / 100 / 12;
  return pv * r * Math.pow(1 + r, nper) / (Math.pow(1 + r, nper) - 1);
}

function calcular() {
  const v = {};
  for (const [key, input] of Object.entries(inputs)) {
    const val = input.value;
    v[key] = isNaN(parseFloat(val)) ? val : parseFloat(val);
  }

  if (v.precoCompra <= 0) { alert('Preço compra > 0'); return; }
  if (v.vidaUtilTco <= 0) { alert('Vida útil > 0'); return; }
  if (v.hrsAno <= 0) { alert('Horas/ano > 0'); return; }

  const horasIniciais = v.condTco === 'usado' ? (v.hrsUsadoTco || 0) : 0;
  const horasRestantes = v.vidaUtilTco - horasIniciais;
  const anosVida = Math.max(1, Math.ceil(horasRestantes / v.hrsAno));

  // Financiamento
  const valorFinanciado = v.precoCompra * (v.pctFinTco / 100);
  const valorProprio = v.precoCompra - valorFinanciado;
  const parcelaMensal = valorFinanciado > 0 ? pmt(v.taxaFin, v.prazoFin, valorFinanciado) : 0;
  const parcelaAnual = parcelaMensal * 12;
  const totalJuros = parcelaMensal * v.prazoFin - valorFinanciado;

  // Depreciação linear
  const depreciacaoAnual = (v.precoCompra - v.valResidual) / anosVida;

  // Custo operacional anual
  const custoOpAnual = v.combAnual + v.opAnual + v.prevAnual + v.corrAnual + v.segAnual + v.rastAnual + v.pneusAnual + v.outrosAnual;

  // Fluxo de caixa anual (VPL)
  let vpl = 0;
  let tirFluxo = [-v.precoCompra]; // ano 0 = investimento inicial
  const fluxoAnual = [];
  let valorLivro = v.precoCompra;
  let saldoDevedor = valorFinanciado;

  for (let ano = 1; ano <= anosVida; ano++) {
    const capex = ano === 1 ? v.precoCompra : 0;

    // Financiamento: principal + juros
    let finPrinc = 0, finJuros = 0;
    if (saldoDevedor > 0 && ano <= v.prazoFin / 12) {
      finJuros = saldoDevedor * (v.taxaFin / 100);
      finPrinc = parcelaAnual - finJuros;
      saldoDevedor = Math.max(0, saldoDevedor - finPrinc);
    }
    const finTotal = finPrinc + finJuros;

    // Custo de capital sobre capital próprio médio
    const capProprioMedio = valorProprio * (1 - (ano - 0.5) / anosVida); // simplificado
    const custoCapital = capProprioMedio * (v.waccTco / 100);

    // Depreciação
    const dep = depreciacaoAnual;
    valorLivro -= dep;

    // Total ano
    const totalAno = finTotal + custoOpAnual + custoCapital;
    const vpAno = totalAno / Math.pow(1 + v.waccTco / 100, ano);
    vpl += vpAno;
    tirFluxo.push(-totalAno);

    fluxoAnual.push({
      ano, capex, finPrinc, finJuros, finTotal, custoOpAnual, dep, custoCapital,
      totalAno, vpAno, saldoDevedor, valorLivro
    });
  }

  // Valor residual no final (entrada de caixa)
  const vpResidual = v.valResidual / Math.pow(1 + v.waccTco / 100, anosVida);
  vpl -= vpResidual; // subtrai porque é entrada
  tirFluxo[tirFluxo.length - 1] += v.valResidual;

  // TCO Total = VPL dos custos
  const tcoTotal = vpl;

  // Custo/hora
  const horasTotais = anosVida * v.hrsAno;
  const custoHora = tcoTotal / horasTotais;

  // Comparativo Aluguel
  const custoRentalAnual = (v.diariaRental / 8) * v.hrsAno;
  let vplRental = 0;
  for (let a = 1; a <= anosVida; a++) {
    vplRental += custoRentalAnual / Math.pow(1 + v.waccTco / 100, a);
  }

  // Comparativo Terceirização
  const custoTercAnual = v.custTerc * v.hrsAno;
  let vplTerc = 0;
  for (let a = 1; a <= anosVida; a++) {
    vplTerc += custoTercAnual / Math.pow(1 + v.waccTco / 100, a);
  }

  // TIR aproximada (busca binária)
  let tir = 0;
  {
    let low = -0.5, high = 2.0;
    for (let i = 0; i < 50; i++) {
      const mid = (low + high) / 2;
      let npv = 0;
      for (let t = 0; t < tirFluxo.length; t++) {
        npv += tirFluxo[t] / Math.pow(1 + mid, t);
      }
      if (npv > 0) low = mid; else high = mid;
    }
    tir = (low + high) / 2;
  }

  // Payback vs Aluguel
  const economiaAnualVsRental = custoRentalAnual - (custoOpAnual + (parcelaAnual * (v.prazoFin/12 >= 1 ? 1 : 0))); // simplificado
  const paybackAnos = economiaAnualVsRental > 0 ? v.precoCompra / economiaAnualVsRental : Infinity;

  // Breakdown VPL
  const vplCapex = v.precoCompra;
  const vplFin = fluxoAnual.reduce((s, f) => s + (f.finJuros / Math.pow(1 + v.waccTco/100, f.ano)), 0);
  const vplOp = fluxoAnual.reduce((s, f) => s + (f.custoOpAnual / Math.pow(1 + v.waccTco/100, f.ano)), 0);
  const vplCap = fluxoAnual.reduce((s, f) => s + (f.custoCapital / Math.pow(1 + v.waccTco/100, f.ano)), 0);

  // Cenários
  const baseHrs = v.hrsAno;
  const baseVida = v.vidaUtilTco;
  const baseRes = v.valResidual;
  const baseComb = v.combAnual;

  const cenarios = [
    { nome: 'Base', hrs: baseHrs, vida: baseVida, res: baseRes, comb: baseComb },
    { nome: 'Baixa utilização (-30% hrs)', hrs: baseHrs * 0.7, vida: baseVida, res: baseRes, comb: baseComb * 0.7 },
    { nome: 'Alta utilização (+30% hrs)', hrs: Math.min(4000, baseHrs * 1.3), vida: baseVida, res: baseRes * 0.9, comb: baseComb * 1.3 },
    { nome: 'Vida útil -20%', hrs: baseHrs, vida: baseVida * 0.8, res: baseRes * 0.7, comb: baseComb },
    { nome: 'Vida útil +20%', hrs: baseHrs, vida: baseVida * 1.2, res: baseRes * 1.2, comb: baseComb },
    { nome: 'Valor residual zero', hrs: baseHrs, vida: baseVida, res: 0, comb: baseComb },
    { nome: 'Combustível +25%', hrs: baseHrs, vida: baseVida, res: baseRes, comb: baseComb * 1.25 },
    { nome: 'WACC +3pp', hrs: baseHrs, vida: baseVida, res: baseRes, comb: baseComb, wacc: v.waccTco + 3 }
  ];

  const cenarioResultados = cenarios.map(c => {
    const wacc = c.wacc || v.waccTco;
    const hrsIni = v.condTco === 'usado' ? (v.hrsUsadoTco || 0) : 0;
    const hrsRest = c.vida - hrsIni;
    const anos = Math.max(1, Math.ceil(hrsRest / c.hrs));
    const depA = (v.precoCompra - c.res) / anos;
    const combA = c.comb;
    const opA = v.opAnual * (c.hrs / baseHrs);
    const prevA = v.prevAnual;
    const corrA = v.corrAnual * (c.hrs / baseHrs);
    const segA = v.segAnual;
    const rastA = v.rastAnual;
    const pneusA = v.pneusAnual * (c.hrs / baseHrs);
    const outrosA = v.outrosAnual;
    const custoOpA = combA + opA + prevA + corrA + segA + rastA + pneusA + outrosA;

    let vplC = v.precoCompra;
    for (let a = 1; a <= anos; a++) {
      const capProp = valorProprio * (1 - (a - 0.5) / anos);
      const cc = capProp * (wacc / 100);
      const tot = custoOpA + cc;
      vplC += tot / Math.pow(1 + wacc/100, a);
    }
    vplC -= c.res / Math.pow(1 + wacc/100, anos);
    const ch = vplC / (anos * c.hrs);
    const delta = ((ch - custoHora) / custoHora) * 100;
    return { ...c, custoHora: ch, delta };
  });

  // Render
  document.getElementById('resCodTco').textContent = v.codTco;
  document.getElementById('resTcoTotal').textContent = fmtBRL(tcoTotal);
  document.getElementById('resCustoHoraProprio').textContent = fmtBRL2(custoHora) + '/h';
  document.getElementById('resVpl').textContent = fmtBRL(vpl);
  document.getElementById('resTir').textContent = fmtNum(tir * 100, 1) + '%';
  document.getElementById('resPaybackTco').textContent = isFinite(paybackAnos) ? fmtNum(paybackAnos, 1) + ' anos' : '—';
  document.getElementById('resAnosVida').textContent = anosVida;

  const opts = [
    { label: 'Comprar', vpl: tcoTotal, cor: '#0b5f57' },
    { label: 'Alugar (Rental)', vpl: vplRental, cor: '#f59e0b' },
    { label: 'Terceirizar', vpl: vplTerc, cor: '#9a3412' }
  ].sort((a,b) => a.vpl - b.vpl);
  document.getElementById('resMelhorOpcao').textContent = opts[0].label;
  document.getElementById('resMelhorOpcao').style.color = opts[0].cor;

  document.getElementById('breakdownTco').innerHTML = [
    { label: 'CAPEX (aquisição)', value: vplCapex, cor: '#9a3412' },
    { label: 'Juros financiamento (VPL)', value: vplFin, cor: '#f59e0b' },
    { label: 'Operacional (VPL)', value: vplOp, cor: '#0b5f57' },
    { label: 'Custo capital próprio (VPL)', value: vplCap, cor: '#6b7280' },
    { label: '(-) Valor residual (VP)', value: -vpResidual, cor: '#0b5f57' },
    { label: '<strong>TCO Total (VPL)</strong>', value: tcoTotal, total: true }
  ].map(b => `
    <div style="${b.total ? 'font-weight:700;color:var(--azul-petroleo);border-top:2px solid var(--azul-petroleo);padding-top:8px;margin-top:4px' : ''}">
      <span>${b.label}</span>
      <span style="text-align:right;display:block;color:${b.cor || (b.value >= 0 ? '#9a3412' : 'var(--azul-petroleo)')}">${fmtBRL(b.value)}</span>
    </div>
  `).join('');

  const tb = document.getElementById('tbodyComparativo');
  tb.innerHTML = `
    <tr style="border-bottom:1px solid #f0efe9"><td style="padding:10px 12px;font-weight:600;color:var(--texto-escuro)">VPL Total Custos</td><td style="padding:10px 12px;text-align:right;color:var(--azul-petroleo);font-weight:600">${fmtBRL(tcoTotal)}</td><td style="padding:10px 12px;text-align:right;color:#b45309;font-weight:600">${fmtBRL(vplRental)}</td><td style="padding:10px 12px;text-align:right;color:#9a3412;font-weight:600">${fmtBRL(vplTerc)}</td></tr>
    <tr style="border-bottom:1px solid #f0efe9"><td style="padding:10px 12px;color:var(--texto-escuro)">Custo/Hora Equiv.</td><td style="padding:10px 12px;text-align:right;color:var(--azul-petroleo)">${fmtBRL2(custoHora)}/h</td><td style="padding:10px 12px;text-align:right;color:#b45309">${fmtBRL2(vplRental/horasTotais)}/h</td><td style="padding:10px 12px;text-align:right;color:#9a3412">${fmtBRL2(vplTerc/horasTotais)}/h</td></tr>
    <tr style="border-bottom:1px solid #f0efe9"><td style="padding:10px 12px;color:var(--texto-escuro)">CAPEX Inicial</td><td style="padding:10px 12px;text-align:right;color:#9a3412">${fmtBRL(v.precoCompra)}</td><td style="padding:10px 12px;text-align:right;color:#b45309">R$ 0</td><td style="padding:10px 12px;text-align:right;color:#9a3412">R$ 0</td></tr>
    <tr style="border-bottom:1px solid #f0efe9"><td style="padding:10px 12px;color:var(--texto-escuro)">Flexibilidade</td><td style="padding:10px 12px;text-align:right;color:var(--texto-secundario)">Baixa</td><td style="padding:10px 12px;text-align:right;color:#b45309">Alta</td><td style="padding:10px 12px;text-align:right;color:#9a3412">Muito Alta</td></tr>
    <tr><td style="padding:10px 12px;color:var(--texto-escuro)">Risco Obsolescência</td><td style="padding:10px 12px;text-align:right;color:#9a3412">Alto</td><td style="padding:10px 12px;text-align:right;color:#b45309">Baixo</td><td style="padding:10px 12px;text-align:right;color:#9a3412">Nulo</td></tr>
  `;

  const tb2 = document.getElementById('tbodyFluxoAnual');
  tb2.innerHTML = fluxoAnual.map(f => `
    <tr style="border-bottom:1px solid #f0efe9">
      <td style="padding:8px 10px;color:var(--texto-escuro)">${f.ano}</td>
      <td style="padding:8px 10px;text-align:right;color:#9a3412">${fmtBRL(f.capex)}</td>
      <td style="padding:8px 10px;text-align:right;color:#b45309">${fmtBRL(f.finTotal)}</td>
      <td style="padding:8px 10px;text-align:right;color:var(--azul-petroleo)">${fmtBRL(f.custoOpAnual)}</td>
      <td style="padding:8px 10px;text-align:right;color:var(--texto-secundario)">${fmtBRL(f.dep)}</td>
      <td style="padding:8px 10px;text-align:right;color:var(--texto-secundario)">${fmtBRL(f.custoCapital)}</td>
      <td style="padding:8px 10px;text-align:right;color:var(--texto-escuro);font-weight:600">${fmtBRL(f.totalAno)}</td>
      <td style="padding:8px 10px;text-align:right;color:var(--azul-petroleo)">${fmtBRL(f.vpAno)}</td>
    </tr>
  `).join('');

  const tb3 = document.getElementById('tbodyCenariosTco');
  tb3.innerHTML = cenarioResultados.map(c => `
    <tr style="border-bottom:1px solid #f0efe9 ${c.nome === 'Base' ? ';font-weight:600' : ''}">
      <td style="padding:10px 12px;color:var(--texto-escuro)">${c.nome}</td>
      <td style="padding:10px 12px;text-align:right;color:var(--texto-secundario)">${fmtNum(c.hrs, 0)}</td>
      <td style="padding:10px 12px;text-align:right;color:var(--texto-secundario)">${fmtNum(c.vida, 0)}</td>
      <td style="padding:10px 12px;text-align:right;color:var(--texto-secundario)">${fmtBRL(c.res)}</td>
      <td style="padding:10px 12px;text-align:right;color:var(--texto-secundario)">${fmtBRL(c.comb)}</td>
      <td style="padding:10px 12px;text-align:right;color:var(--texto-escuro);font-weight:600">${fmtBRL2(c.custoHora)}/h</td>
      <td style="padding:10px 12px;text-align:right;color:${c.delta > 0 ? '#9a3412' : 'var(--azul-petroleo)'};font-weight:600">${c.delta >= 0 ? '+' : ''}${fmtNum(c.delta, 1)}%</td>
    </tr>
  `).join('');

  document.getElementById('resultadosTco').style.display = 'block';
  saveState();
}

document.getElementById('btnCalcTco').addEventListener('click', calcular);
document.getElementById('btnResetTco').addEventListener('click', () => {
  for (const [key, input] of Object.entries(inputs)) { input.value = DEFAULTS_TCO[key]; }
  localStorage.clear();
  document.getElementById('resultadosTco').style.display = 'none';
  toggleUsado();
});

document.getElementById('btnCopiarLinkTco').addEventListener('click', () => {
  const params = new URLSearchParams();
  for (const [key, input] of Object.entries(inputs)) { params.set(key, input.value); }
  navigator.clipboard.writeText(`${window.location.origin}${window.location.pathname}?${params.toString()}`).then(() => {
    const btn = document.getElementById('btnCopiarLinkTco');
    const orig = btn.textContent; btn.textContent = 'Copiado!'; setTimeout(() => btn.textContent = orig, 2000);
  });
});

document.getElementById('btnExportarCSVTco').addEventListener('click', () => {
  const linhas = [
    ['Parâmetro', 'Valor'],
    ['Código', inputs.codTco.value],
    ['Categoria', inputs.catTco.value],
    ['Modelo', inputs.modTco.value],
    ['Condição', inputs.condTco.value],
    ['Horas usadas', inputs.hrsUsadoTco.value],
    ['Preço compra', inputs.precoCompra.value],
    ['Vida útil (h)', inputs.vidaUtilTco.value],
    ['Valor residual', inputs.valResidual.value],
    ['Horas/ano', inputs.hrsAno.value],
    ['% Financiado', inputs.pctFinTco.value],
    ['Taxa financiamento', inputs.taxaFin.value],
    ['Prazo financiamento', inputs.prazoFin.value],
    ['WACC', inputs.waccTco.value],
    ['Combustível/ano', inputs.combAnual.value],
    ['Operador/ano', inputs.opAnual.value],
    ['Preventiva/ano', inputs.prevAnual.value],
    ['Corretiva/ano', inputs.corrAnual.value],
    ['Seguro/ano', inputs.segAnual.value],
    ['Rastreamento/ano', inputs.rastAnual.value],
    ['Pneus/ano', inputs.pneusAnual.value],
    ['Outros/ano', inputs.outrosAnual.value],
    ['Diária Rental', inputs.diariaRental.value],
    ['Terceirização/h', inputs.custTerc.value],
    ['', ''],
    ['Resultado', 'Valor'],
    ['TCO Total (VPL)', document.getElementById('resTcoTotal').textContent],
    ['Custo/Hora Próprio', document.getElementById('resCustoHoraProprio').textContent],
    ['VPL', document.getElementById('resVpl').textContent],
    ['TIR', document.getElementById('resTir').textContent],
    ['Payback vs Aluguel', document.getElementById('resPaybackTco').textContent],
    ['Anos Vida Restante', document.getElementById('resAnosVida').textContent],
    ['Melhor Opção', document.getElementById('resMelhorOpcao').textContent],
  ];
  const csv = linhas.map(r => r.map(c => `"${c}"`).join(',')).join('\n');
  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
  const link = document.createElement('a');
  link.href = URL.createObjectURL(blob);
  link.download = `tco-${inputs.codTco.value}-${new Date().toISOString().split('T')[0]}.csv`;
  link.click();
});

let timeout;
Object.values(inputs).forEach(input => {
  input.addEventListener('input', () => { clearTimeout(timeout); timeout = setTimeout(calcular, 300); });
  input.addEventListener('change', calcular);
});

Object.values(inputs).forEach(input => {
  input.addEventListener('change', () => {
    const params = new URLSearchParams();
    for (const [key, inp] of Object.entries(inputs)) { params.set(key, inp.value); }
    window.history.replaceState({}, '', `${window.location.pathname}?${params.toString()}`);
  });
});

loadState();
calcular();
</script>