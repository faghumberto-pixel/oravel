<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% if title %}{{ title }} · {% endif %}oravel.org</title>
{% if description %}<meta name="description" content="{{ description }}">{% endif %}
{% if canonical %}<link rel="canonical" href="{{ canonical }}">{% endif %}
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/styles.css">
<!-- Privacy-friendly analytics by Plausible -->
<script async src="https://plausible.io/js/pa-OrrxHOqJlZvhZmdXDoovK.js"></script>
<script>
  window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
  plausible.init()
</script>
{% if pagefind %}<link rel="stylesheet" href="/pagefind/pagefind-ui.css">{% endif %}
</head>
<body>

<!-- Header -->
<header class="site-header" role="banner">
<div class="container">
<a href="/" class="site-logo" aria-label="oravel.org - Página inicial">
<span class="o">o</span><span class="ravel">ravel</span><span class="org">.org</span>
</a>
<div class="site-tagline" aria-hidden="true">
<span>Inteligência para</span>
<span>quem administra locadoras</span>
</div>
<button class="menu-toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="site-nav">☰</button>
<nav class="site-nav" id="site-nav" role="navigation">
<div class="site-nav-item site-nav-dropdown">
<button class="site-nav-dropdown-btn" aria-haspopup="true" aria-expanded="false" aria-label="Categorias de conteúdo">
Categorias
<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
</button>
<div class="site-nav-dropdown-menu" role="menu">
<a href="/gestao-e-operacao/" role="menuitem">Gestão da Locadora</a>
<a href="/vendas/" role="menuitem">Comercial e Crescimento</a>
<a href="/tecnologia/" role="menuitem">Tecnologia Aplicada</a>
<a href="/reforma-tributaria/" role="menuitem">Legislação e Tributação</a>
<a href="/comunidade/" role="menuitem">Comunidade e Inteligência</a>
<a href="/la-fora/" role="menuitem">Mercado e Tendências</a>
</div>
</div>
<a href="/ferramentas/" class="site-nav-item">Ferramentas</a>
<a href="/painel-mercado/" class="site-nav-item">Painel do Mercado</a>
<a href="/gazeta/" class="site-nav-item">Gazeta Oravel</a>
<a href="/sobre/" class="site-nav-item">Sobre</a>
</nav>
<div class="site-header-actions">
<button class="search-btn" aria-label="Buscar" id="search-toggle">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.3-4.3"/></svg>
</button>
<a href="/gazeta/" class="btn">Assine a Gazeta</a>
</div>
</div>
</header>

<!-- Mobile search overlay -->
<div id="search-overlay" class="search-overlay" hidden aria-hidden="true">
<div class="container">
<div id="search-header-mobile"></div>
<button class="btn btn-outline" id="search-close">Fechar busca</button>
</div>
</div>

<div id="aviso-cadastro" class="aviso" role="status" hidden>Cadastro concluído com sucesso! Agora você já pode <a href="/entrar/">entrar</a> e comentar nos artigos.</div>
<script>(function(){var q=new URLSearchParams(location.search),b=document.getElementById("aviso-cadastro");if(q.get("cadastro")==="ok"){b.hidden=false}else if(q.get("gazeta")==="ok"){b.textContent="Inscrição feita! Você vai receber a Gazeta Oravel no seu e-mail.";b.hidden=false}else{return}history.replaceState(null,"",location.pathname)})()</script>

<!-- Main Content -->
<main id="main-content">
{{ content | safe }}
</main>

<!-- Footer Bar -->
<footer class="footer-bar" role="contentinfo">
<div class="footer-wave" aria-hidden="true"></div>
<div class="container">
<div class="footer-lamp" aria-hidden="true">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6"/><path d="M12 12V9"/><path d="M12 9a3 3 0 0 0-3-3 3 3 0 0 0-3 3v6"/><path d="M12 9a3 3 0 0 1 3-3 3 3 0 0 1 3 3v6"/></svg>
</div>
<div class="footer-text">
<h3>Mais conhecimento. Mais resultado.</h3>
<p>A Oravel.org é o ponto de encontro de quem busca evoluir no mercado de locação de equipamentos.</p>
</div>
<a href="/publicacoes/" class="btn btn-branco-outline">Conheça nosso conteúdo →</a>
</div>
</footer>

<!-- Site Footer -->
<footer class="site-footer" role="contentinfo">
<div class="container">
<span>Uma iniciativa da <a href="/sobre/">Oravel</a>. Conteúdo informativo, não substitui a orientação de contador, advogado ou consultor.</span>
<span class="footer-links">
<a href="/manifesto/">Manifesto</a>
<a href="/politica-editorial/">Política Editorial</a>
<a href="/como-produzimos/">Como Produzimos</a>
<a href="/autores/">Quem Escreve</a>
<a href="/sobre/">Sobre</a>
<a href="/privacidade/">Privacidade</a>
<a href="/termos/">Termos</a>
<a href="/publicacoes/">Todas as publicações</a>
</span>
</div>
</footer>

<script>
(function(){
  var toggle=document.querySelector('.menu-toggle'),nav=document.getElementById('site-nav');
  if(!toggle||!nav)return;
  function fechar(){nav.classList.remove('open');toggle.setAttribute('aria-expanded','false');toggle.textContent='\u2630';document.body.style.overflow='';}
  toggle.addEventListener('click',function(){var o=nav.classList.toggle('open');toggle.setAttribute('aria-expanded',o);toggle.textContent=o?'\u2715':'\u2630';document.body.style.overflow=o?'hidden':'';});
  nav.querySelectorAll('a').forEach(function(a){a.addEventListener('click',fechar)});
  document.addEventListener('keydown',function(e){if(e.key==='Escape')fechar()});
})();
</script>
{% if pagefind %}
<script src="/pagefind/pagefind-ui.js"></script>
<script>
window.addEventListener('DOMContentLoaded', () => {
  // Search toggle (mobile)
  const searchToggle = document.getElementById('search-toggle');
  const searchOverlay = document.getElementById('search-overlay');
  const searchClose = document.getElementById('search-close');
  if (searchToggle && searchOverlay) {
    searchToggle.addEventListener('click', () => {
      searchOverlay.hidden = false;
      searchOverlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      // Initialize Pagefind on first open
      if (!window.pagefindInitialized) {
        new PagefindUI({
          element: '#search-header-mobile',
          showSubResults: true,
          showImages: false,
          translations: {
            placeholder: 'Buscar artigos, assuntos...',
            zeroResults: 'Nenhum resultado para "[[searchTerm]]"',
            manyResults: '[[count]] resultados',
            searchLabel: 'Buscar'
          }
        });
        window.pagefindInitialized = true;
      }
    });
    searchClose.addEventListener('click', () => {
      searchOverlay.hidden = true;
      searchOverlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    });
  }

  // Busca na página /busca/ (se existir)
  const searchPage = document.getElementById('search');
  if (searchPage && searchPage !== document.getElementById('search-header')) {
    new PagefindUI({
      element: '#search',
      showSubResults: true,
      showImages: false,
      translations: {
        placeholder: 'Buscar no oravel.org...',
        zeroResults: 'Nenhum resultado para "[[searchTerm]]"',
        manyResults: '[[count]] resultados para "[[searchTerm]]"',
        searchLabel: 'Buscar'
      }
    });
  }
});
</script>
{% endif %}
</body>
</html>