---
layout: base.njk
pagefind: true
---
{% set themePosts = collections[theme] %}
<header class="tema-hero">
<div class="container">
<div class="breadcrumb"><a href="/">Início</a> / {{ theme | themeLabel }}</div>
<h1 class="page-title">{{ theme | themeLabel }}</h1>
<p>{{ themeDesc[theme] }}</p>
</div>
</header>

<div class="container tema-wrap">
<div class="main-layout">
<main class="main-content">
<h2 class="eyebrow">Artigos deste tema <span class="count-pill">{{ themePosts | length }}</span></h2>
<div class="cards-artigos">
{% for post in themePosts %}
<a class="card-artigo" href="{{ post.url }}">
{% if post.data.image %}<img class="card-artigo__img" src="{{ post.data.image }}" alt="" loading="lazy" width="600" height="400">{% else %}<div class="card-artigo__img card-artigo__img--vazia" aria-hidden="true"></div>{% endif %}
<div class="card-artigo__corpo">
<span class="card-artigo__meta">{{ post.date | dateBr }} · Leitura de {{ post.data.readingTime or '—' }}</span>
<h3>{{ post.data.title }}</h3>
<p>{{ post.data.summary }}</p>
<span class="card-artigo__ler">Ler artigo →</span>
</div>
</a>
{% else %}
<p class="muted">Nenhum artigo publicado neste tema ainda.</p>
{% endfor %}
</div>
</main>

<aside class="post-sidebar">
<!-- Filtros por data -->
<div class="sidebar-widget">
<h4>Filtrar por data</h4>
<ul class="date-filters">
<li><a href="/{{ theme }}/" class="active">Todos <span class="count">{{ themePosts | length }}</span></a></li>
{% set dateGroups = themePosts | groupByDate() %}
{% for group in dateGroups %}
<li><a href="/{{ theme }}/?month={{ group.key }}">{{ group.key | formatMonth }} <span class="count">{{ group.items.length }}</span></a></li>
{% endfor %}
</ul>
</div>

<!-- Neste tema -->
<div class="sidebar-widget">
<h4>Neste tema</h4>
<div class="lista-tema">
{% for post in themePosts %}
<a href="{{ post.url }}">{{ post.data.title }}</a>
{% endfor %}
</div>
</div>

<!-- Comunidade -->
<div class="sidebar-cta">
<h4>Troque experiência</h4>
<p>Como a sua locadora lida com isso? Conte para o grupo.</p>
<a href="/comunidade/" class="btn">Conhecer a comunidade</a>
</div>
</aside>
</div>
</div>
