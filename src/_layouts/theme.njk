---
layout: base.njk
pagefind: true
---
{% set themePosts = collections[theme] %}
<section class="container" style="padding:48px 32px 16px">
<div class="breadcrumb"><a href="/">Início</a> / {{ theme | themeLabel }}</div>
<h1 class="page-title">{{ theme | themeLabel }}</h1>
<p style="margin:12px 0 0;font-size:17px;color:#4a5361;max-width:64ch">{{ themeDesc[theme] }}</p>
</section>

<section class="container" style="padding:24px 32px 72px">
<div class="main-layout">
<main class="main-content">
<h2 class="section-title" style="font-size:15px;letter-spacing:.08em;text-transform:uppercase;color:#6b7280;margin:16px 0 0">Artigos deste tema</h2>
<div style="margin-top:18px;display:flex;flex-direction:column">
{% for post in themePosts %}
<a class="item-lista" href="{{ post.url }}" style="padding:22px 0;border-top:1px solid #e4dfd3;text-decoration:none;color:inherit{% if loop.last %};border-bottom:1px solid #e4dfd3{% endif %}">
{% if post.data.image %}<img class="thumb" src="{{ post.data.image }}" alt="" loading="lazy" width="200" height="133">{% endif %}
<div class="corpo-item">
<div class="section-title" style="font-size:21px;font-weight:600;color:#1b2230;line-height:1.3">{{ post.data.title }}</div>
<div style="margin-top:6px;color:#4a5361;font-size:15.5px">{{ post.data.summary }}</div>
<div style="margin-top:8px;display:flex;flex-wrap:wrap;gap:8px 24px;font-size:13px;color:#6b7280">
<span>Leitura de {{ post.data.readingTime or '—' }} · {{ post.date | dateBr }}</span>
{% if post.data.source %}<span>Fonte: {{ post.data.source }}</span>{% endif %}
</div>
</div>
</a>
{% else %}
<p class="muted">Nenhum artigo publicado neste tema ainda.</p>
{% endfor %}
</div>
</main>

<aside class="post-sidebar">
<!-- Filtros por data -->
<div class="sidebar-widget">
<h4>Filtrar por data</h4>
<ul class="date-filters">
<li><a href="/{{ theme }}/" class="active">Todos <span class="count">{{ themePosts | length }}</span></a></li>
{% set dateGroups = themePosts | groupByDate() %}
{% for group in dateGroups %}
<li><a href="/{{ theme }}/?month={{ group.key }}">{{ group.key | formatMonth }} <span class="count">{{ group.items.length }}</span></a></li>
{% endfor %}
</ul>
</div>

<!-- Neste tema -->
<div class="sidebar-widget">
<h4>Neste tema</h4>
<div style="display:flex;flex-direction:column;gap:12px;font-weight:600">
{% for post in themePosts %}
<a href="{{ post.url }}" style="color:#1b2230;text-decoration:none;padding:8px 0;border-bottom:1px solid #f0efe9;font-size:14px">{{ post.data.title }}</a>
{% endfor %}
</div>
</div>

<!-- Comunidade -->
<div style="background:#12312e;border-radius:16px;padding:24px;color:#e8f1ef">
<div style="font-weight:700;font-size:18px;color:#fff">Troque experiência</div>
<p style="margin:8px 0 16px;color:#c9ded9;font-size:15px">Como a sua locadora lida com isso? Conte para o grupo.</p>
<a href="/comunidade/" class="btn btn-amber">Conhecer a comunidade</a>
</div>
</aside>
</div>
</section>