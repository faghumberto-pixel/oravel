<h3 style="font-family:var(--font-titulo);font-size:20px;font-weight:600;margin:0 0 16px;color:var(--texto-escuro)">Crescimento do n total por mês</h3>
<div style="height:250px;position:relative"><canvas id="chartEvolucaoAmostra"></canvas></div>
<p class="muted-sm" style="margin:12px 0 0;font-size:12px">Fonte: Painel do Mercado Oravel • Atualizado mensalmente</p>
</div>

<div style="margin-top:24px">
<h3 style="font-family:var(--font-titulo);font-size:20px;font-weight:600;margin:0 0 16px;color:var(--texto-escuro)">Cobertura por célula (porte × região × categoria)</h3>
<div style="overflow-x:auto">
<table style="width:100%;border-collapse:collapse;font-size:14px" id="tabelaCobertura">
<thead>
<tr style="background:#e7f1ef;border-bottom:2px solid var(--azul-petroleo)">
<th style="padding:10px 12px;text-align:left;font-weight:600;color:var(--texto-escuro)">Mês</th>
<th style="padding:10px 12px;text-align:right;font-weight:600;color:var(--texto-escuro)">Células com n≥10</th>
<th style="padding:10px 12px;text-align:right;font-weight:600;color:var(--texto-escuro)">Células com n≥30</th>
<th style="padding:10px 12px;text-align:right;font-weight:600;color:var(--texto-escuro)">Total células ativas</th>
<th style="padding:10px 12px;text-align:left;font-weight:600;color:var(--texto-escuro)">Cobertura % (n≥10)</th>
</tr>
