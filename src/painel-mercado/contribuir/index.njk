---

<section class="container" style="padding-top:56px;padding-bottom:24px;max-width:720px">
<div class="breadcrumb"><a href="/">Início</a> / <a href="/painel-mercado/">Painel do Mercado</a> / Contribuir</div>
<h1 class="page-title">Contribuir com Dados</h1>
<p style="margin:16px 0 0;font-size:19px;color:var(--texto-secundario);max-width:64ch">Suas respostas são <strong>100% anônimas</strong>. Nenhum dado identifica sua empresa. Você recebe de volta seu posicionamento (P25/P50/P75) no seu segmento (porte × região × categoria).</p>
</section>

<section class="container" style="padding-top:24px;padding-bottom:80px;max-width:720px">

<!-- Benefícios -->
<div style="background:#e7f1ef;border:1px solid var(--azul-petroleo);border-radius:14px;padding:24px;margin-bottom:32px">
<h2 class="section-title section-title-h3" style="margin:0 0 12px;color:var(--azul-petroleo);display:flex;align-items:center;gap:8px"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg> O que você ganha contribuindo</h2>
<ul style="margin:0;padding-left:20px;line-height:2;color:var(--azul-petroleo)">
<li><strong>Benchmarking personalizado:</strong> Seu P25/P50/P75 em diária, utilização, disponibilidade, custo manutenção/receita — comparado ao seu segmento exato.</li>
<li><strong>Acesso antecipado:</strong> Recebe o relatório mensal do Painel antes da publicação no portal.</li>
<li><strong>Peso na comunidade:</strong> Sua contribuição melhora a qualidade dos dados para todos (incluindo você).</li>
<li><strong>Zero custo, zero spam:</strong> 3 minutos por mês. E-mail só para enviar seu relatório pessoal.</li>
</ul>
</div>

<!-- Formulário -->
<form id="formContribuir" class="form-conta" style="max-width:100%">
<input type="hidden" name="timestamp" id="inputTimestamp">
<input type="hidden" name="versao" value="1.0">

<!-- Seção 1: Perfil da Locadora -->
<fieldset style="border:0;margin:0 0 24px;padding:0;border-top:3px solid var(--azul-petroleo);padding-top:16px">
<legend style="font-family:var(--font-titulo);font-size:22px;font-weight:600;color:var(--texto-escuro);margin-bottom:16px">1. Perfil da Locadora</legend>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
<label>
<span>Porte da frota (total de equipamentos)</span>
<select name="porteFrota" required style="font-family:inherit;padding:10px 12px;border:1px solid var(--cinza-claro);border-radius:8px;background:#fff;font-size:16px;width:100%">
<option value="">Selecione</option>
<option value="micro">Micro (1–10 equipamentos)</option>
<option value="pequena">Pequena (11–50 equipamentos)</option>
<option value="media">Média (51–200 equipamentos)</option>
<option value="grande">Grande (201–500 equipamentos)</option>
<option value="muito-grande">Muito Grande (500+ equipamentos)</option>
</select>
</label>

<label>
<span>Região da sede</span>
<select name="regiao" required style="font-family:inherit;padding:10px 12px;border:1px solid var(--cinza-claro);border-radius:8px;background:#fff;font-size:16px;width:100%">
<option value="">Selecione</option>
<option value="sudeste">Sudeste (SP, RJ, MG, ES)</option>
<option value="sul">Sul (PR, SC, RS)</option>
<option value="centro-oeste">Centro-Oeste (GO, MT, MS, DF)</option>
<option value="nordeste">Nordeste (BA, PE, CE, MA, PB, RN, PI, AL, SE)</option>
<option value="norte">Norte (AM, PA, RO, RR, AC, AP, TO)</option>
</select>
</label>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px">
<label>
<span>Categoria principal da frota (>50% dos equipamentos)</span>
<select name="categoriaPrincipal" required style="font-family:inherit;padding:10px 12px;border:1px solid var(--cinza-claro);border-radius:8px;background:#fff;font-size:16px;width:100%">
<option value="">Selecione</option>
<option value="terraplanagem">Terraplanagem (escavadeiras, pás, motoniveladoras, caminhões fora de estrada)</option>
<option value="elevacao">Elevação (plataformas tesoura/articuladas, guindastes, manipuladores)</option>
<option value="compactacao">Compactação (rolos lisos, pés de carneiro, compactadores de percussão)</option>
<option value="geradores">Geradores de energia (diesel, gás, híbridos)</option>
<option value="compressores">Compressores de ar (portáteis, estacionários)</option>
<option value="mista">Frota mista (sem categoria dominante >50%)</option>
</select>
</label>

<label>
<span>Anos de operação</span>
<select name="anosOperacao" style="font-family:inherit;padding:10px 12px;border:1px solid var(--cinza-claro);border-radius:8px;background:#fff;font-size:16px;width:100%">
<option value="">Selecione</option>
<option value="0-2">0–2 anos</option>
<option value="3-5">3–5 anos</option>
<option value="6-10">6–10 anos</option>
<option value="11-20">11–20 anos</option>
<option value="20+">20+ anos</option>
</select>
</label>
</div>
</fieldset>

<!-- Seção 2: KPIs do Mês de Referência -->
<fieldset style="border:0;margin:0 0 24px;padding:0;border-top:3px solid var(--azul-petroleo);padding-top:16px">
<legend style="font-family:var(--font-titulo);font-size:22px;font-weight:600;color:var(--texto-escuro);margin-bottom:16px">2. KPIs do Mês de Referência</legend>
<p class="muted-sm" style="margin:0 0 16px">Referência: <strong>mês anterior completo</strong> (ex: se hoje é novembro, informe outubro). Use dados do seu financeiro/operacional.</p>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
<label>
<span>Mês de referência</span>
<input type="month" name="mesReferencia" required style="font-family:inherit;padding:10px 12px;border:1px solid var(--cinza-claro);border-radius:8px;background:#fff;font-size:16px;width:100%">
</label>

<label>
<span>Receita bruta de locação no mês (R$)</span>
<input type="number" name="receitaBruta" step="1000" min="0" required placeholder="Ex: 150000" style="font-family:inherit;padding:10px 12px;border:1px solid var(--cinza-claro);border-radius:8px;background:#fff;font-size:16px;width:100%">
</label>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px">
<label>
<span>Diária média praticada (R$/8h) — média ponderada por frota</span>
<input type="number" name="diariaMedia" step="10" min="0" required placeholder="Ex: 420" style="font-family:inherit;padding:10px 12px;border:1px solid var(--cinza-claro);border-radius:8px;background:#fff;font-size:16px;width:100%">
</label>

<label>
<span>Utilização média da frota (%) — horas alugadas / horas disponíveis</span>
<input type="number" name="utilizacaoMedia" step="1" min="0" max="100" required placeholder="Ex: 62" style="font-family:inherit;padding:10px 12px;border:1px solid var(--cinza-claro);border-radius:8px;background:#fff;font-size:16px;width:100%">
</label>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px">
<label>
<span>Disponibilidade da frota (%) — equipamentos operacionais / total</span>
<input type="number" name="disponibilidade" step="1" min="0" max="100" required placeholder="Ex: 87" style="font-family:inherit;padding:10px 12px;border:1px solid var(--cinza-claro);border-radius:8px;background:#fff;font-size:16px;width:100%">
</label>

<label>
<span>Custo total de manutenção no mês (R$) — preventiva + corretiva</span>
<input type="number" name="custoManutencao" step="1000" min="0" required placeholder="Ex: 28000" style="font-family:inherit;padding:10px 12px;border:1px solid var(--cinza-claro);border-radius:8px;background:#fff;font-size:16px;width:100%">
</label>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px">
<label>
<span>Nº de equipamentos na frota no mês</span>
<input type="number" name="totalEquipamentos" step="1" min="1" required placeholder="Ex: 45" style="font-family:inherit;padding:10px 12px;border:1px solid var(--cinza-claro);border-radius:8px;background:#fff;font-size:16px;width:100%">
</label>

<label>
<span>Nº de ordens de serviço (manutenção) no mês</span>
<input type="number" name="ordensServico" step="1" min="0" placeholder="Ex: 18" style="font-family:inherit;padding:10px 12px;border:1px solid var(--cinza-claro);border-radius:8px;background:#fff;font-size:16px;width:100%">
</label>
</div>
</fieldset>

<!-- Seção 3: Tecnologia e Maturidade (Opcional) -->
<fieldset style="border:0;margin:0 0 24px;padding:0;border-top:3px solid #f59e0b;padding-top:16px">
<legend style="font-family:var(--font-titulo);font-size:22px;font-weight:600;color:var(--texto-escuro);margin-bottom:16px">3. Tecnologia e Maturidade <span style="font-size:13px;font-weight:400;color:var(--texto-secundario)">(opcional, mas valioso)</span></legend>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
<label style="display:flex;align-items:center;gap:8px;cursor:pointer">
<input type="checkbox" name="techTelemetria" value="1" style="width:18px;height:18px;accent-color:var(--azul-petroleo)"> Telemetria / GPS / Rastreador
</label>
<label style="display:flex;align-items:center;gap:8px;cursor:pointer">
<input type="checkbox" name="techERP" value="1" style="width:18px;height:18px;accent-color:var(--azul-petroleo)"> ERP de Locação (gestão de contratos, faturamento, frota)
</label>
<label style="display:flex;align-items:center;gap:8px;cursor:pointer">
<input type="checkbox" name="techNFe" value="1" style="width:18px;height:18px;accent-color:var(--azul-petroleo)"> Emissão automática de NFe/NFSe
</label>
<label style="display:flex;align-items:center;gap:8px;cursor:pointer">
<input type="checkbox" name="techAppCliente" value="1" style="width:18px;height:18px;accent-color:var(--azul-petroleo)"> App/Portal do Cliente (solicitação, acompanhamento, notas)
</label>
<label style="display:flex;align-items:center;gap:8px;cursor:pointer">
<input type="checkbox" name="techQR" value="1" style="width:18px;height:18px;accent-color:var(--azul-petroleo)"> QR Code / RFID no controle de equipamentos
</label>
<label style="display:flex;align-items:center;gap:8px;cursor:pointer">
<input type="checkbox" name="techIAPreditiva" value="1" style="width:18px;height:18px;accent-color:var(--azul-petroleo)"> IA para manutenção preditiva / roteirização
</label>
</div>

<div style="margin-top:20px">
<label>
<span>Autoavaliação de maturidade digital (1 a 5)</span>
<select name="maturidadeDigital" style="font-family:inherit;padding:10px 12px;border:1px solid var(--cinza-claro);border-radius:8px;background:#fff;font-size:16px;width:100%">
<option value="">Selecione</option>
<option value="1">Nível 1 — Inicial (processos manuais, planilhas, reativo)</option>
<option value="2">Nível 2 — Gerenciada (ERP básico, alguma telemetria, KPIs básicos)</option>
<option value="3">Nível 3 — Definida (processos padronizados, dashboards, telemetria integrada)</option>
<option value="4">Nível 4 — Quantitativa (KPIs em tempo real, IA/preditivo, automação avançada)</option>
<option value="5">Nível 5 — Otimizada (decisão data-driven, ecossistema integrado, inovação contínua)</option>
</select>
</label>
</div>
</fieldset>

<!-- Seção 4: Contato para Relatório Pessoal -->
<fieldset style="border:0;margin:0 0 24px;padding:0;border-top:3px solid var(--azul-petroleo);padding-top:16px">
<legend style="font-family:var(--font-titulo);font-size:22px;font-weight:600;color:var(--texto-escuro);margin-bottom:16px">4. Onde Enviar Seu Relatório Pessoal</legend>
<p class="muted-sm" style="margin:0 0 16px">Seu e-mail <strong>não será divulgado, vendido ou usado para marketing</strong>. Serve apenas para enviar seu benchmarking personalizado (PDF) e o relatório mensal do Painel.</p>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
<label>
<span>E-mail para receber relatório *</span>
<input type="email" name="email" required placeholder="seu@email.com" style="font-family:inherit;padding:10px 12px;border:1px solid var(--cinza-claro);border-radius:8px;background:#fff;font-size:16px;width:100%">
</label>

<label>
<span>Confirmar e-mail *</span>
<input type="email" name="emailConfirm" required placeholder="seu@email.com" style="font-family:inherit;padding:10px 12px;border:1px solid var(--cinza-claro);border-radius:8px;background:#fff;font-size:16px;width:100%">
</label>
</div>

<div style="margin-top:16px">
<label style="display:flex;align-items:flex-start;gap:10px;cursor:pointer">
<input type="checkbox" name="aceiteLGPD" required id="aceiteLGPD" style="width:18px;height:18px;accent-color:var(--azul-petroleo);margin-top:2px">
<span style="font-size:14px;color:var(--texto-secundario);line-height:1.6">Autorizo o processamento anônimo dos meus dados para fins estatísticos do Painel do Mercado Oravel, conforme <a href="/politica-editorial/" style="color:var(--azul-petroleo)">Política Editorial</a> e <a href="/privacidade/" style="color:var(--azul-petroleo)">Privacidade</a>. Posso solicitar exclusão a qualquer momento pelo e-mail <a href="mailto:dados@oravel.org" style="color:var(--azul-petroleo)">dados@oravel.org</a>.</span>
</label>
</div>
</fieldset>

<!-- Submit -->
<div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:8px">
<button type="submit" class="btn">Enviar e Receber Meu Benchmarking</button>
<a href="/painel-mercado/" class="btn btn-outline">← Voltar ao Painel</a>
</div>

<div id="formMsg" style="margin-top:16px;min-height:24px"></div>
</form>

<!-- Nota final -->
<div style="margin-top:48px;padding:24px;background:#fbfaf6;border:1px solid var(--cinza-claro);border-radius:14px">
<h3 style="font-family:var(--font-titulo);font-size:18px;font-weight:600;margin:0 0 12px;color:var(--texto-escuro)">Compromisso de Privacidade</h3>
<ul style="margin:0;padding-left:20px;line-height:1.9;color:var(--texto-secundario);font-size:15px">
<li><strong>Anonimato garantido:</strong> Seu CNPJ, nome da empresa e e-mail NUNCA aparecem no Painel público nem são compartilhados.</li>
<li><strong>Agregação mínima:</strong> Benchmarks só são exibidos com n≥10 por célula (porte × região × categoria).</li>
<li><strong>Controle total:</strong> Pode solicitar exclusão dos seus dados a qualquer momento: <a href="mailto:dados@oravel.org" style="color:var(--azul-petroleo)">dados@oravel.org</a>.</li>
<li><strong>LGPD:</strong> Base legal: legítimo interesse (art. 7º, IX) + consentimento para envio do relatório pessoal.</li>
</ul>
</div>

</section>

<script>
// ===== FORMULÁRIO CONTRIBUIR =====
document.addEventListener('DOMContentLoaded', () => {
  const form = document.getElementById('formContribuir');
  const msgDiv = document.getElementById('formMsg');

  // Preencher timestamp
  document.getElementById('inputTimestamp').value = new Date().toISOString();

  // Pré-preencher mês anterior
  const mesRef = document.querySelector('input[name="mesReferencia"]');
  const agora = new Date();
  const mesAnterior = new Date(agora.getFullYear(), agora.getMonth() - 1, 1);
  mesRef.value = mesAnterior.toISOString().slice(0, 7);

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Validação de e-mail
    const email = form.email.value.trim();
    const emailConfirm = form.emailConfirm.value.trim();
    if (email !== emailConfirm) {
      showMsg('Os e-mails não conferem. Verifique.', 'error');
      return;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showMsg('E-mail inválido.', 'error');
      return;
    }
    if (!form.aceiteLGPD.checked) {
      showMsg('É necessário aceitar os termos de privacidade.', 'error');
      return;
    }

    const submitBtn = form.querySelector('button[type="submit"]');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Enviando...';
    showMsg('Processando sua contribuição...', 'info');

    // Coletar dados
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    // Calcular campos derivados
    const receita = parseFloat(data.receitaBruta) || 0;
    const custoManut = parseFloat(data.custoManutencao) || 0;
    data.manutencaoSobreReceita = receita > 0 ? ((custoManut / receita) * 100).toFixed(1) : 0;

    const diaria = parseFloat(data.diariaMedia) || 0;
    const utiliz = parseFloat(data.utilizacaoMedia) || 0;
    const equipamentos = parseInt(data.totalEquipamentos) || 0;
    const diasUteis = 22; // assumido
    const horasDia = 8;
    const horasDispMes = equipamentos * diasUteis * horasDia;
    const horasAlugadas = horasDispMes * (utiliz / 100);
    const receitaEsperada = diaria * (horasAlugadas / 8);
    data.receitaEsperadaCalculada = Math.round(receitaEsperada);

    try {
      // Em produção: enviar para Firestore / API / webhook
      // await fetch('/api/painel-mercado/contribuir', { method: 'POST', body: JSON.stringify(data) });

      // Simulação: salvar no localStorage para demo
      const contribuicoes = JSON.parse(localStorage.getItem('painel_contribuicoes') || '[]');
      data.id = 'contrib_' + Date.now();
      contribuicoes.push(data);
      localStorage.setItem('painel_contribuicoes', JSON.stringify(contribuicoes));

      // Gerar benchmark simulado
      const benchmark = gerarBenchmarkSimulado(data);

      showMsg(`
        <div style="background:#e7f1ef;border:1px solid var(--azul-petroleo);border-radius:12px;padding:20px">
          <h3 style="margin:0 0 12px;color:var(--azul-petroleo)">✅ Contribuição recebida!</h3>
          <p style="margin:0 0 16px;color:var(--texto-escuro)">Obrigado! Seus dados foram registrados anonimamente.</p>
          <div style="background:#fff;border:1px solid var(--cinza-claro);border-radius:8px;padding:16px;margin-bottom:16px">
            <strong style="color:var(--texto-escuro)">Seu Benchmarking Preliminar (simulado):</strong>
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:12px;font-size:14px">
              <div style="text-align:center;padding:12px;background:#fbfaf6;border-radius:8px">
                <div style="font-family:var(--font-titulo);font-size:20px;font-weight:600;color:var(--azul-petroleo)">${benchmark.diariaP50}</div>
                <div style="font-size:12px;color:var(--texto-secundario)">Diária P50 do seu segmento</div>
              </div>
              <div style="text-align:center;padding:12px;background:#fbfaf6;border-radius:8px">
                <div style="font-family:var(--font-titulo);font-size:20px;font-weight:600;color:var(--azul-petroleo)">${benchmark.utilizacaoP50}%</div>
                <div style="font-size:12px;color:var(--texto-secundario)">Utilização P50</div>
              </div>
              <div style="text-align:center;padding:12px;background:#fbfaf6;border-radius:8px">
                <div style="font-family:var(--font-titulo);font-size:20px;font-weight:600;color:var(--azul-petroleo)">${benchmark.manutP50}%</div>
                <div style="font-size:12px;color:var(--texto-secundario)">Manut/Receita P50</div>
              </div>
            </div>
            <p style="margin:12px 0 0;font-size:13px;color:var(--texto-secundario)">Seu relatório completo (P25/P50/P75 + gráficos) será enviado para <strong>${email}</strong> na próxima segunda-feira.</p>
          </div>
        </div>
      `, 'success');

      form.reset();
      document.getElementById('inputTimestamp').value = new Date().toISOString();
      mesRef.value = mesAnterior.toISOString().slice(0, 7);

    } catch (err) {
      showMsg('Erro ao enviar. Tente novamente ou entre em contato: dados@oravel.org', 'error');
      console.error(err);
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Enviar e Receber Meu Benchmarking';
    }
  });

  function showMsg(html, type) {
    const colors = { error: '#9a3412', success: '#0b5f57', info: '#0b5f57' };
    msgDiv.innerHTML = `<div style="padding:16px;border-radius:8px;border-left:4px solid ${colors[type]};background:${type === 'error' ? '#fef3e7' : '#e7f1ef'};color:var(--texto-escuro)">${html}</div>`;
  }

  function gerarBenchmarkSimulado(data) {
    // Simulação baseada no porte/categoria
    const baseDiaria = { terraplanagem: 420, elevacao: 280, compactacao: 250, geradores: 310, compressores: 180, mista: 350 };
    const baseUtil = { micro: 55, pequena: 60, media: 65, grande: 68, 'muito-grande': 70 };
    const baseManut = { micro: 24, pequena: 20, media: 18, grande: 15, 'muito-grande': 12 };

    const cat = data.categoriaPrincipal || 'mista';
    const porte = data.porteFrota || 'media';

    return {
      diariaP50: 'R$ ' + (baseDiaria[cat] || 350).toLocaleString('pt-BR'),
      utilizacaoP50: baseUtil[porte] || 62,
      manutP50: baseManut[porte] || 18
    };
  }
});
</script>