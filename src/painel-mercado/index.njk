// ===== RENDERIZAÇÃO =====

// KPIs Cards
function renderKPIs() {
  const container = document.getElementById('kpiCards');
  container.innerHTML = PAINEL_DATA.kpis.map(kpi => `
    <div style="background:#fff;border:1px solid var(--cinza-claro);border-radius:14px;padding:24px;display:flex;flex-direction:column;gap:8px">
      <div style="display:flex;align-items:center;gap:10px">
        <span style="font-size:clamp(1.25rem,2.4vw,1.75rem)">${kpi.icon}</span>
        <span style="font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--texto-secundario)">${kpi.label}</span>
      </div>
      <div style="font-family:var(--font-titulo);font-size:clamp(1.25rem,2.4vw,2.25rem);font-weight:600;color:var(--texto-escuro);line-height:1.1">${kpi.value}</div>
      <div style="font-size:13.5px;color:var(--texto-secundario)">${kpi.sub}</div>
    </div>
  `).join('');
}

// Gráficos Chart.js
const chartInstances = {};

function createChart(canvasId, chartData, type = 'bar') {
  const ctx = document.getElementById(canvasId);
  if (!ctx) return;
  if (chartInstances[canvasId]) chartInstances[canvasId].destroy();

  const isHorizontal = type === 'horizontalBar';
  chartInstances[canvasId] = new Chart(ctx, {
    type: isHorizontal ? 'bar' : type,
    data: {
      labels: chartData.labels,
      datasets: chartData.datasets
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      indexAxis: isHorizontal ? 'y' : 'x',
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: '#1b2230',
          titleColor: '#fff',
          bodyColor: '#e8f1ef',
          padding: 12,
          cornerRadius: 8,
          displayColors: false
        }
      },
      scales: {
        x: {
          grid: { display: false },
          ticks: { color: '#6b7280', font: { size: 12 } }
        },
        y: {
          grid: { color: '#f0efe9' },
          ticks: { color: '#6b7280', font: { size: 12 } },
          beginAtZero: true
        }
      },
      interaction: { intersect: false, mode: 'index' }
    }
  });
}

// Render todos os gráficos
function renderCharts() {
  createChart('chartDiariaCategoria', PAINEL_DATA.charts.diariaCategoria, 'horizontalBar');
  createChart('chartUtilizacaoPorte', PAINEL_DATA.charts.utilizacaoPorte);
  createChart('chartDisponibilidade', PAINEL_DATA.charts.disponibilidade, 'line');
  createChart('chartCustoManutencao', PAINEL_DATA.charts.custoManutencao);
  createChart('chartTecnologias', PAINEL_DATA.charts.tecnologias, 'horizontalBar');
  createChart('chartMaturidade', PAINEL_DATA.charts.maturidade);
}

// Tabela de Dores
function renderDores() {
  const tbody = document.getElementById('tbodyDores');
  tbody.innerHTML = PAINEL_DATA.dores.map(d => `
    <tr style="border-bottom:1px solid #f0efe9">
      <td style="padding:12px 16px;font-weight:600;color:var(--azul-petroleo)">${d.pos}º</td>
      <td style="padding:12px 16px;color:var(--texto-escuro)">${d.dor}</td>
      <td style="padding:12px 16px;text-align:right;font-weight:600;color:var(--texto-escuro)">${d.pct}%</td>
      <td style="padding:12px 16px">
        <span style="display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;font-size:12px;font-weight:600;${d.tendencia === 'up' ? 'background:#fef3e7;color:#9a3412' : 'background:#e7f1ef;color:var(--azul-petroleo)'}">
          ${d.tendencia === 'up' ? '↑' : '→'} ${d.tendencia === 'up' ? 'Subindo' : 'Estável'}
        </span>
      </td>
      <td style="padding:12px 16px">
        <a href="${d.artigo}" style="color:var(--azul-petroleo);text-decoration:none;font-size:13.5px;font-weight:500">Ver artigo →</a>
      </td>
    </tr>
  `).join('');
}

