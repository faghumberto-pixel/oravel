<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
// ===== PAINEL DO MERCADO v3 — dados publicados, com fonte =====
// Todos os números abaixo vêm das fontes citadas em cada gráfico. Não há dados gerados.

const POSTS = [{% for p in collections.posts %}"{{ p.url }}"{% if not loop.last %},{% endif %}{% endfor %}];

// KPMG / Analoc / Sobratema — Rental Market Report (Sobratema, 26/03/2026)
const FATURAMENTO = { 2025: 49.4, 2026: 52.9 }; // R$ bilhões
const REGIOES = {
  sudeste: { rot: 'Sudeste', pct: 60 }, nordeste: { rot: 'Nordeste', pct: 15 }, sul: { rot: 'Sul', pct: 13 },
  'centro-oeste': { rot: 'Centro-Oeste', pct: 7 }, norte: { rot: 'Norte', pct: 5 }
};

const FATORES = [
  { fator: 'Clientes liberam capital por não precisarem comprar equipamentos', tipo: 'Impulso', fonte: 'Sobratema, 26/03/2026' },
  { fator: 'O locador assume a manutenção e a gestão da frota', tipo: 'Impulso', fonte: 'Sobratema, 26/03/2026', slug: 'preventiva-ou-corretiva-qual-compensa' },
  { fator: 'Mineração, agronegócio e infraestrutura (concessões e saneamento)', tipo: 'Impulso', fonte: 'SICEPOT-RS (Sobratema), 02/02/2026' },
  { fator: 'Juros altos e fluxo de caixa, em um setor intensivo em capital', tipo: 'Desafio', fonte: 'Sobratema, 26/03/2026', url: '/ferramentas/viabilidade-frota/' },
  { fator: 'Escassez de mão de obra especializada', tipo: 'Desafio', fonte: 'Sobratema, 26/03/2026' },
  { fator: 'Reforma tributária: carga pode subir de 10% para até 14% da receita bruta', tipo: 'Desafio', fonte: 'Analoc, via Revista Construa, 15/10/2025', slug: 'split-payment-o-efeito-no-caixa-da-locadora' },
  { fator: 'Entrada de fabricantes chineses, que segura os preços dos equipamentos', tipo: 'Fator de mercado', fonte: 'SICEPOT-RS (Sobratema), 02/02/2026' }
];

const el = (id) => document.getElementById(id);
const bi = (v) => 'R$ ' + v.toLocaleString('pt-BR', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' bi';
const CLARO = '#B9C8C6', ESCURO = '#1E4D49';

// Escala sequencial de uma só cor (verde Oravel), usada no mapa e no mapa de calor
const hex = (h) => [1, 3, 5].map(i => parseInt(h.slice(i, i + 2), 16));
function escala(t) { const a = hex('#E6F1EF'), b = hex('#1E4D49'); return 'rgb(' + a.map((v, i) => Math.round(v + (b[i] - v) * t)).join(',') + ')'; }
const textoSobre = (t) => t > 0.5 ? '#FFFFFF' : '#12201F';

function valor(ano, regiao) { return regiao === 'todas' ? FATURAMENTO[ano] : FATURAMENTO[ano] * REGIOES[regiao].pct / 100; }

function renderKPIs(f) {
  const reg = f.regiao !== 'todas', rot = reg ? REGIOES[f.regiao].rot : 'Brasil';
  const kpis = [
    { label: 'Faturamento do setor', value: bi(valor(f.ano, f.regiao)), sub: `${f.ano === '2025' ? 'Realizado' : 'Projeção'} ${f.ano} · ${rot}${reg ? ' (estimativa)' : ''}` },
    { label: 'Participação no mercado', value: (reg ? REGIOES[f.regiao].pct : 100) + '%', sub: reg ? `Parcela do ${rot} no faturamento` : 'Todas as regiões' },
    { label: 'Crescimento projetado 2026', value: '+7%', sub: 'Sobre 2025 · Brasil' },
    { label: 'Penetração da locação', value: '40%', sub: 'Locação vs. propriedade · KPMG' },
    { label: 'Empresas no setor', value: '50 mil', sub: '200 mil funcionários · Brasil' },
    { label: 'Peso no PIB', value: '0,4%', sub: 'EUA 0,26% · Europa 0,15%' }
  ];
  el('kpiCards').innerHTML = kpis.map(k => `
    <div class="kpi"><div class="kpi__rotulo">${k.label}</div><div class="kpi__valor">${k.value}</div><div class="kpi__sub">${k.sub}</div></div>`).join('');
}

// ---- Gráficos Chart.js: barras arredondadas com gradiente e valores sobre as barras ----
const instancias = {};
function gradiente(c1, c2, horizontal) {
  return (ctx) => { const a = ctx.chart.chartArea; if (!a) return c2;
    const g = horizontal ? ctx.chart.ctx.createLinearGradient(a.left, 0, a.right, 0) : ctx.chart.ctx.createLinearGradient(0, a.bottom, 0, a.top);
    g.addColorStop(0, c1); g.addColorStop(1, c2); return g; };
}
const rotulosValor = {
  id: 'rotulosValor',
  afterDatasetsDraw(chart, _, o) {
    if (!o || !o.ativo) return;
    const ctx = chart.ctx; ctx.save(); ctx.font = '600 12px Inter, system-ui, sans-serif'; ctx.fillStyle = '#12201F';
    const horizontal = chart.options.indexAxis === 'y';
    chart.data.datasets.forEach((d, di) => {
      if (o.soDataset != null && di !== o.soDataset) return;
      chart.getDatasetMeta(di).data.forEach((pt, i) => {
        const txt = o.formato ? o.formato(i, di) : String(d.data[i]); if (!txt) return;
        const pos = pt.tooltipPosition ? pt.tooltipPosition() : pt;
        ctx.textAlign = horizontal ? 'left' : 'center'; ctx.textBaseline = 'middle';
        if (horizontal) ctx.fillText(txt, (o.xFim ? o.xFim(i, pt) : pt.x) + 8, pt.y);
        else ctx.fillText(txt, pt.x, pt.y - 12);
      });
    });
    ctx.restore();
  }
};
function grafico(id, tipo, labels, datasets, opts = {}) {
  if (instancias[id]) instancias[id].destroy();
  const horizontal = tipo === 'horizontalBar', linha = tipo === 'line';
  instancias[id] = new Chart(el(id), {
    type: horizontal ? 'bar' : tipo, plugins: [rotulosValor],
    data: { labels, datasets: datasets.map(d => ({ borderWidth: 0, borderRadius: linha ? 0 : 8, borderSkipped: false, barThickness: horizontal ? 22 : 28, maxBarThickness: 36, ...d })) },
    options: {
      responsive: true, maintainAspectRatio: false, indexAxis: horizontal ? 'y' : 'x', animation: { duration: 500 },
      layout: { padding: { top: 20, right: horizontal ? 84 : 8 } },
      plugins: {
        rotulosValor: { ativo: opts.valores !== false, formato: opts.formato, xFim: opts.xFim, soDataset: opts.soDataset },
        legend: { display: datasets.length > 1, position: 'bottom', labels: { boxWidth: 10, boxHeight: 10, usePointStyle: true, color: '#5B6B69', font: { size: 12 } } },
        tooltip: { backgroundColor: '#0B2B2A', titleColor: '#fff', bodyColor: '#E8F1EF', padding: 12, cornerRadius: 10, displayColors: datasets.length > 1,
          callbacks: { label: opts.tooltip || ((c) => (c.dataset.label ? c.dataset.label + ': ' : '') + (opts.prefixo || '') + c.parsed[horizontal ? 'x' : 'y'].toLocaleString('pt-BR') + (opts.sufixo || '')) } }
      },
      scales: {
        x: { stacked: !!opts.stacked, display: !horizontal || opts.eixo !== false, grid: { display: false }, border: { display: false }, ticks: { color: '#5B6B69', font: { size: 12 }, display: !horizontal }, beginAtZero: true, ...(horizontal && opts.max ? { max: opts.max } : {}) },
        y: { stacked: !!opts.stacked, grid: { display: !horizontal, color: '#EEF1F0' }, border: { display: false }, ticks: { color: '#5B6B69', font: { size: 12 }, display: true, ...(opts.ticksY ? opts.ticksY : {}) }, beginAtZero: true, ...(!horizontal && opts.max ? { max: opts.max } : {}) }
      }
    }
  });
}

// ---- Mapa (cartograma) e mapa de calor regional ----
const LAYOUT_MAPA = { norte: 'c1 r1', nordeste: 'c2 r1', 'centro-oeste': 'c1 r2', sudeste: 'c2 r2', sul: 'c2 r3' };
function renderMapa(f) {
  const max = 60;
  el('mapaRegioes').innerHTML = Object.keys(REGIOES).map(k => {
    const r = REGIOES[k], t = Math.sqrt(r.pct / max), sel = f.regiao === k, dim = f.regiao !== 'todas' && !sel;
    return `<button type="button" class="tile tile--${LAYOUT_MAPA[k].replace(' ', '-')}${sel ? ' tile--sel' : ''}${dim ? ' tile--dim' : ''}" data-regiao="${k}" aria-pressed="${sel}"
      style="background:${escala(t)};color:${textoSobre(t)}"><span class="tile__nome">${r.rot}</span><span class="tile__pct">${r.pct}%</span><span class="tile__val">${bi(FATURAMENTO[f.ano] * r.pct / 100)}</span></button>`;
  }).join('');
}
function renderHeat(f) {
  const anos = ['2025', '2026'], ks = Object.keys(REGIOES), max = FATURAMENTO['2026'];
  let h = `<div class="heat__linha heat__linha--cab" role="row"><span role="columnheader">Região</span>` +
    anos.map(a => `<span role="columnheader" class="${f.ano === a ? 'heat__col--sel' : ''}">${a === '2025' ? '2025 (realizado)' : '2026 (projeção)'}</span>`).join('') + '</div>';
  h += ks.map(k => `<div class="heat__linha${f.regiao === k ? ' heat__linha--sel' : ''}" role="row"><span role="rowheader">${REGIOES[k].rot}</span>` +
    anos.map(a => { const v = FATURAMENTO[a] * REGIOES[k].pct / 100, t = Math.sqrt(v / max);
      return `<button type="button" role="cell" class="heat__cel${f.regiao === k && f.ano === a ? ' heat__cel--sel' : ''}" data-regiao="${k}" data-ano="${a}" style="background:${escala(t)};color:${textoSobre(t)}">${bi(v)}</button>`; }).join('') + '</div>').join('');
  el('heatRegiao').innerHTML = h;
}

function renderFiltrados(f) { renderMapa(f); renderHeat(f); }

function renderFixos() {
  grafico('chartVendas', 'bar', ['2023', '2024', '2025'], [
    { label: 'Total de máquinas para construção', data: [53.5, 58.2, 56.3], backgroundColor: gradiente('#5E8F89', '#1E4D49') },
    { label: 'Linha amarela', data: [32.3, 36.6, 34.5], backgroundColor: gradiente('#DCE7E5', '#9FB9B5') }
  ], { sufixo: ' mil', formato: (i, di) => (di === 0 ? [53.5, 58.2, 56.3] : [32.3, 36.6, 34.5])[i].toLocaleString('pt-BR'), ticksY: { callback: (v) => v } });
  grafico('chartFrotaParada', 'line', ['2017', '2023', '2024'], [{
    label: 'Frota parada', data: [57, 19, 11], borderColor: '#1E4D49', borderWidth: 3, tension: 0.35, fill: true,
    backgroundColor: (ctx) => { const a = ctx.chart.chartArea; if (!a) return 'transparent'; const g = ctx.chart.ctx.createLinearGradient(0, a.top, 0, a.bottom); g.addColorStop(0, 'rgba(30,77,73,.35)'); g.addColorStop(1, 'rgba(30,77,73,0)'); return g; },
    pointRadius: 5, pointBackgroundColor: '#fff', pointBorderColor: '#1E4D49', pointBorderWidth: 2, pointHoverRadius: 7
  }], { sufixo: '%', max: 100, formato: (i) => [57, 19, 11][i] + '%' });
  grafico('chartCategorias', 'horizontalBar', ['Plataformas aéreas', 'Betoneiras'], [
    { label: 'Mínimo da faixa', data: [90, 70], backgroundColor: gradiente('#5E8F89', '#1E4D49', true), borderRadius: { topLeft: 8, bottomLeft: 8 } },
    { label: 'Até o máximo da faixa', data: [5, 5], backgroundColor: '#B9C8C6', borderRadius: { topRight: 8, bottomRight: 8 } }
  ], { max: 100, stacked: true, soDataset: 1, formato: (i) => ['90% a 95%', '70% a 75%'][i], xFim: (i, pt) => pt.x,
       tooltip: (c) => c.datasetIndex === 0 ? `A partir de ${c.raw}% das vendas` : `Até ${c.dataIndex === 0 ? 95 : 75}% das vendas` });
  grafico('chartFinanciamento', 'horizontalBar', ['Capital próprio', 'Finame', 'CDC'], [
    { label: '% dos entrevistados', data: [33, 23, 19], backgroundColor: gradiente('#5E8F89', '#1E4D49', true) }
  ], { sufixo: '%', max: 50, formato: (i) => [33, 23, 19][i] + '%' });
  comparativo('compMecanizacao', [{ rot: 'Brasil', v: 30, txt: 'cerca de 30%', forte: true }, { rot: 'Mercados globais', v: 60, txt: 'até 60%' }], 70);
  comparativo('compPib', [{ rot: 'Brasil', v: 0.4, txt: '0,4%', forte: true }, { rot: 'Estados Unidos', v: 0.26, txt: '0,26%' }, { rot: 'Europa', v: 0.15, txt: '0,15%' }], 0.5);
}
function comparativo(id, itens, max) {
  el(id).innerHTML = itens.map(i => `
    <div class="comp__linha"><span class="comp__rot">${i.rot}</span>
      <span class="comp__trilho"><span class="comp__barra${i.forte ? ' comp__barra--forte' : ''}" style="width:${Math.round(i.v / max * 100)}%"></span></span>
      <span class="comp__val">${i.txt}</span></div>`).join('');
}

function renderFatores() {
  const link = (d) => { const u = d.url || (d.slug && POSTS.find(p => p.endsWith('-' + d.slug + '/'))); return u ? `<a class="tabela-link" href="${u}">Ver conteúdo →</a>` : '<span class="muted-sm">—</span>'; };
  el('tbodyFatores').innerHTML = FATORES.map(d => `
    <tr><td>${d.fator}</td><td><span class="natureza natureza--${d.tipo === 'Desafio' ? 'desafio' : 'neutra'}">${d.tipo}</span></td><td class="fonte-cel">${d.fonte}</td><td>${link(d)}</td></tr>`).join('');
}

function filtros() { return { ano: el('filtroAno').value, regiao: el('filtroRegiao').value }; }
function atualizar() {
  const f = filtros(), reg = f.regiao !== 'todas';
  el('resumoFiltro').innerHTML = `Exibindo <strong>${reg ? REGIOES[f.regiao].rot : 'Brasil'}</strong> · ${f.ano === '2025' ? 'realizado 2025' : 'projeção 2026'}${reg ? ' · valores regionais são estimativas por participação' : ''}`;
  renderKPIs(f); renderFiltrados(f);
  const q = new URLSearchParams();
  if (f.ano !== '2025') q.set('ano', f.ano);
  if (reg) q.set('regiao', f.regiao);
  history.replaceState(null, '', location.pathname + (q.toString() ? '?' + q : ''));
}

document.addEventListener('DOMContentLoaded', () => {
  const q = new URLSearchParams(location.search);
  [['ano', 'filtroAno'], ['regiao', 'filtroRegiao']].forEach(([k, id]) => {
    const v = q.get(k), s = el(id); if (v && [...s.options].some(o => o.value === v)) s.value = v;
    s.addEventListener('change', atualizar);
  });
  document.addEventListener('click', (e) => {
    const t = e.target.closest('.tile, .heat__cel'); if (!t) return;
    const k = t.dataset.regiao, a = t.dataset.ano;
    if (a) { el('filtroAno').value = a; el('filtroRegiao').value = k; }
    else el('filtroRegiao').value = el('filtroRegiao').value === k ? 'todas' : k;
    atualizar();
  });
  el('btnLimparFiltros').addEventListener('click', () => { el('filtroAno').value = '2025'; el('filtroRegiao').value = 'todas'; atualizar(); });
  renderFixos(); renderFatores(); atualizar();
});
</script>
<script src="/assets/grafico-tv.js" defer></script>
</div>
