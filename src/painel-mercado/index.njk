<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
// ===== PAINEL DO MERCADO v2.0 — filtros dinâmicos =====
// Base ILUSTRATIVA: respostas fictícias geradas com semente fixa (sempre os mesmos números).
// Para dados reais, substituir gerarRespostas() por um carregamento do Firestore/JSON mantendo o mesmo formato.

const POSTS = [{% for p in collections.posts %}"{{ p.url }}"{% if not loop.last %},{% endif %}{% endfor %}];
const MIN_N = 10; // metodologia: mínimo de 10 respostas por recorte
const META = { ultimaAtualizacao: '2026-11-15', proximaColeta: '2026-12-15' };

const PORTES = {
  pequena: { rot: 'Pequena (≤50)', w: .50, util: 58, disp: 84, manut: 22, mat: 1.9, tech: .7, diaria: .95, payback: 26 },
  media:   { rot: 'Média (51-200)', w: .35, util: 65, disp: 87, manut: 18, mat: 2.5, tech: 1,  diaria: 1,   payback: 22 },
  grande:  { rot: 'Grande (200+)', w: .15, util: 68, disp: 90, manut: 15, mat: 3.2, tech: 1.25, diaria: 1.08, payback: 19 }
};
const REGIOES = { sudeste: { w: .42, f: 1.08 }, sul: { w: .20, f: 1.03 }, 'centro-oeste': { w: .14, f: 1 }, nordeste: { w: .17, f: .92 }, norte: { w: .07, f: .95 } };
const CATS = {
  terraplanagem: { rot: 'Terraplanagem', w: .28, diaria: 420 }, elevacao: { rot: 'Elevação', w: .20, diaria: 260 },
  compactacao: { rot: 'Compactação', w: .10, diaria: 300 }, geradores: { rot: 'Geradores', w: .14, diaria: 330 },
  compressores: { rot: 'Compressores', w: .08, diaria: 180 }, mista: { rot: 'Frota mista', w: .20, diaria: 340 }
};
const TECNOLOGIAS = [
  ['Telemetria/GPS', .68], ['ERP de Locação', .54], ['NFe/NFSe Autom.', .48], ['App Cliente', .32],
  ['QR Code/RFID', .28], ['IA Manut. Preditiva', .12], ['Telemetria Avançada', .08], ['Assinatura Digital', .41]
];
const NIVEIS = ['Nível 1: Inicial', 'Nível 2: Gerenciada', 'Nível 3: Definida', 'Nível 4: Quantitativa', 'Nível 5: Otimizada'];
const DORES = [
  { dor: 'Mão de obra qualificada (operadores/mecânicos)', p: .78, tendencia: 'up' },
  { dor: 'Custo de manutenção corretiva imprevisível', p: .71, tendencia: 'stable', slug: 'preventiva-ou-corretiva-qual-compensa' },
  { dor: 'Reforma tributária (IBS/CBS) — incerteza no caixa', p: .65, tendencia: 'up', slug: 'split-payment-o-efeito-no-caixa-da-locadora' },
  { dor: 'Inadimplência e atraso de pagamento de clientes', p: .58, tendencia: 'stable', slug: 'retorno-e-fidelizacao-o-pos-venda-e-parte-da-venda' },
  { dor: 'Dificuldade para precificar diária com margem', p: .52, tendencia: 'up', url: '/ferramentas/preco-diaria/' },
  { dor: 'Falta de peças de reposição / lead time longo', p: .47, tendencia: 'up' },
  { dor: 'Tecnologia: escolher telemetria que integre com ERP', p: .41, tendencia: 'up', slug: 'telemetria-e-rastreamento-o-que-as-fontes-do-setor-descem' },
  { dor: 'Retenção de clientes / churn de contratos', p: .38, tendencia: 'stable', slug: 'estrutura-de-uma-proposta-de-locacao-curta-clara-e-com-prazo' },
  { dor: 'Conformidade trabalhista / NR-11 / NR-12', p: .34, tendencia: 'stable', slug: 'vistoria-na-entrega-e-na-devolucao' },
  { dor: 'Sucessão familiar / governança na locadora', p: .26, tendencia: 'stable' }
];
const MESES = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov'];
const TREND_DISP = [-3,-2,-1,0,0,1,1,0,0,0,0];

function prng(seed) { return () => { seed |= 0; seed = seed + 0x6D2B79F5 | 0; let t = Math.imul(seed ^ seed >>> 15, 1 | seed); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; }; }
function gerarRespostas(n) {
  const r = prng(2026), noise = () => (r() + r() + r() - 1.5) / 0.75; // ~N(0,1) limitado
  const pick = (obj) => { let x = r(), acc = 0; const keys = Object.keys(obj); for (const k of keys) { acc += obj[k].w; if (x <= acc) return k; } return keys[keys.length - 1]; };
  const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
  return Array.from({ length: n }, () => {
    const porte = pick(PORTES), regiao = pick(REGIOES), cat = pick(CATS), P = PORTES[porte];
    return {
      porte, regiao, cat,
      diaria: Math.round(CATS[cat].diaria * P.diaria * REGIOES[regiao].f * (1 + noise() * .12)),
      util: Math.round(clamp(P.util + noise() * 7, 30, 92)),
      disp: Math.round(clamp(P.disp + noise() * 4, 60, 99)),
      manut: Math.round(clamp(P.manut + noise() * 4, 5, 40)),
      payback: Math.round(clamp(P.payback + noise() * 6, 8, 48)),
      mat: clamp(Math.round(P.mat + noise() * 1), 1, 5),
      tech: TECNOLOGIAS.map(([, p]) => r() < clamp(p * P.tech, 0, .95)),
      dores: DORES.map(d => r() < clamp(d.p + (porte === 'grande' ? -.04 : porte === 'pequena' ? .03 : 0), 0, .95)),
      serie: TREND_DISP.map(t => clamp(P.disp + t + noise() * 1.2, 60, 99))
    };
  });
}
const RESPOSTAS = gerarRespostas(240);

// ===== Cálculos =====
const mediana = (a) => { if (!a.length) return null; const s = [...a].sort((x, y) => x - y), m = s.length >> 1; return s.length % 2 ? s[m] : (s[m - 1] + s[m]) / 2; };
const pct = (x, n) => n ? Math.round(x / n * 100) : 0;
const brl = (v) => 'R$ ' + Math.round(v).toLocaleString('pt-BR');

function filtros() { return { porte: el('filtroPorte').value, regiao: el('filtroRegiao').value, categoria: el('filtroCategoria').value }; }
function recorte(f, ignorar) {
  return RESPOSTAS.filter(r => (ignorar === 'porte' || f.porte === 'todos' || r.porte === f.porte)
    && (f.regiao === 'todas' || r.regiao === f.regiao)
    && (ignorar === 'categoria' || f.categoria === 'todas' || r.cat === f.categoria));
}
const el = (id) => document.getElementById(id);

// ===== Renderização =====
function renderKPIs(sub, n) {
  const ok = n >= MIN_N, nota = ok ? `Mediana • n = ${n}` : 'Amostra insuficiente (n < 10)';
  const m = (k) => ok ? mediana(sub.map(r => r[k])) : null;
  const mat = m('mat');
  const kpis = [
    { label: 'Diária Média (P50)', value: ok ? brl(m('diaria')) : '—', icon: '💰', sub: ok ? `8h • ${nota}` : nota },
    { label: 'Utilização Média (P50)', value: ok ? Math.round(m('util')) + '%' : '—', icon: '📊', sub: nota },
    { label: 'Disponibilidade (P50)', value: ok ? Math.round(m('disp')) + '%' : '—', icon: '✅', sub: nota },
    { label: 'Manutenção / Receita (P50)', value: ok ? Math.round(m('manut')) + '%' : '—', icon: '🔧', sub: ok ? `Prev. + Corretiva • n = ${n}` : nota },
    { label: 'Maturidade Digital (P50)', value: ok ? 'Nível ' + Math.round(mat) : '—', icon: '🎯', sub: ok ? `De 5 (Otimizada) • n = ${n}` : nota },
    { label: 'Payback Médio (P50)', value: ok ? Math.round(m('payback')) + ' meses' : '—', icon: '⏱', sub: ok ? `Aquisição equipamento • n = ${n}` : nota }
  ];
  el('kpiCards').innerHTML = kpis.map(k => `
    <div class="kpi-card">
      <div class="kpi-card__topo"><span class="kpi-card__icone">${k.icon}</span><span class="kpi-card__rotulo">${k.label}</span></div>
      <div class="kpi-card__valor">${k.value}</div>
      <div class="kpi-card__sub">${k.sub}</div>
    </div>`).join('');
}

const chartInstances = {};
function grafico(id, tipo, labels, data, opts = {}) {
  const canvas = el(id), aviso = canvas.parentElement.querySelector('.sem-amostra');
  if (chartInstances[id]) { chartInstances[id].destroy(); delete chartInstances[id]; }
  const vazio = !labels.length;
  canvas.hidden = vazio; if (aviso) aviso.hidden = !vazio;
  if (vazio) return;
  const horizontal = tipo === 'horizontalBar';
  chartInstances[id] = new Chart(canvas, {
    type: horizontal ? 'bar' : tipo,
    data: { labels, datasets: [{
      label: opts.label || '', data,
      backgroundColor: opts.cores || (tipo === 'line' ? 'rgba(11,95,87,.1)' : 'rgba(11,95,87,.7)'),
      borderColor: opts.borda || '#0b5f57', borderWidth: tipo === 'line' ? 3 : 2, borderRadius: tipo === 'line' ? 0 : 6,
      fill: tipo === 'line', tension: .3, pointRadius: tipo === 'line' ? 4 : 0, pointBackgroundColor: '#0b5f57'
    }] },
    options: {
      responsive: true, maintainAspectRatio: false, indexAxis: horizontal ? 'y' : 'x', animation: { duration: 350 },
      plugins: { legend: { display: false }, tooltip: { backgroundColor: '#12201F', titleColor: '#fff', bodyColor: '#E8F1EF', padding: 12, cornerRadius: 8, displayColors: false,
        callbacks: { label: (c) => (opts.prefixo || '') + c.parsed[horizontal ? 'x' : 'y'].toLocaleString('pt-BR') + (opts.sufixo || '') } } },
      scales: {
        x: { grid: { display: false }, ticks: { color: '#5B6B69', font: { size: 12 } }, ...(horizontal ? { beginAtZero: true } : {}) },
        y: { grid: { color: '#F0EFE9' }, ticks: { color: '#5B6B69', font: { size: 12 } }, beginAtZero: opts.min0 !== false, ...(opts.max ? { max: opts.max } : {}) }
      }
    }
  });
}

function renderCharts(f, sub, n) {
  const ok = n >= MIN_N;
  ['nDiariaCategoria','nUtilizacaoPorte','nDisponibilidade','nCustoManutencao','nTecnologias','nMaturidade','nDores'].forEach(id => el(id).textContent = n);

  // 1) Diária por categoria (respeita porte e região; se há categoria filtrada, só ela)
  const catKeys = Object.keys(CATS).filter(k => f.categoria === 'todas' || f.categoria === k);
  const dc = catKeys.map(k => ({ k, v: recorte(f, 'categoria').filter(r => r.cat === k).map(r => r.diaria) })).filter(g => g.v.length >= MIN_N);
  grafico('chartDiariaCategoria', 'horizontalBar', dc.map(g => CATS[g.k].rot), dc.map(g => Math.round(mediana(g.v))), { label: 'Diária Média (R$)', prefixo: 'R$ ' });

  // 2) Utilização e 4) Manutenção por porte (respeitam região e categoria)
  const porteKeys = Object.keys(PORTES).filter(k => f.porte === 'todos' || f.porte === k);
  const gp = porteKeys.map(k => ({ k, rs: recorte(f, 'porte').filter(r => r.porte === k) })).filter(g => g.rs.length >= MIN_N);
  grafico('chartUtilizacaoPorte', 'bar', gp.map(g => PORTES[g.k].rot), gp.map(g => Math.round(mediana(g.rs.map(r => r.util)))),
    { label: 'Utilização Média (%)', sufixo: '%', max: 100, cores: ['rgba(11,95,87,.5)', 'rgba(11,95,87,.7)', 'rgba(11,95,87,.9)'] });
  grafico('chartCustoManutencao', 'bar', gp.map(g => PORTES[g.k].rot), gp.map(g => Math.round(mediana(g.rs.map(r => r.manut)))),
    { label: 'Manutenção / Receita (%)', sufixo: '%', cores: 'rgba(154,52,18,.7)', borda: '#9a3412' });

  // 3) Disponibilidade mensal
  grafico('chartDisponibilidade', 'line', ok ? MESES : [], ok ? MESES.map((_, i) => Math.round(mediana(sub.map(r => r.serie[i])) * 10) / 10) : [],
    { label: 'Disponibilidade Média (%)', sufixo: '%', min0: false });

  // 5) Tecnologias
  grafico('chartTecnologias', 'horizontalBar', ok ? TECNOLOGIAS.map(t => t[0]) : [], ok ? TECNOLOGIAS.map((_, i) => pct(sub.filter(r => r.tech[i]).length, n)) : [],
    { label: '% Locadoras', sufixo: '%', max: 100 });

  // 6) Maturidade
  grafico('chartMaturidade', 'bar', ok ? NIVEIS : [], ok ? NIVEIS.map((_, i) => pct(sub.filter(r => r.mat === i + 1).length, n)) : [],
    { label: '% Locadoras', sufixo: '%', cores: ['rgba(245,158,11,.7)', 'rgba(11,95,87,.5)', 'rgba(11,95,87,.7)', 'rgba(11,95,87,.9)', 'rgba(11,95,87,1)'] });
}

function linkArtigo(d) {
  const url = d.url || (d.slug && POSTS.find(u => u.endsWith('-' + d.slug + '/')));
  return url ? `<a class="tabela-link" href="${url}">Ver artigo →</a>` : '<span class="muted-sm">—</span>';
}
function renderDores(sub, n) {
  const tbody = el('tbodyDores');
  if (n < MIN_N) { tbody.innerHTML = '<tr><td colspan="5" class="sem-amostra-linha">Amostra insuficiente para este recorte (n &lt; 10). Tente ampliar os filtros.</td></tr>'; return; }
  const rank = DORES.map((d, i) => ({ ...d, pct: pct(sub.filter(r => r.dores[i]).length, n) })).sort((a, b) => b.pct - a.pct);
  tbody.innerHTML = rank.map((d, i) => `
    <tr>
      <td class="pos">${i + 1}º</td>
      <td>${d.dor}</td>
      <td class="num">${d.pct}%</td>
      <td><span class="tendencia tendencia--${d.tendencia}">${d.tendencia === 'up' ? '↑ Subindo' : '→ Estável'}</span></td>
      <td>${linkArtigo(d)}</td>
    </tr>`).join('');
}

function renderMeta() {
  el('statTotalLocadoras').textContent = RESPOSTAS.length;
  el('statUltimaAtualizacao').textContent = new Date(META.ultimaAtualizacao + 'T12:00:00').toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' });
  el('proximaColeta').textContent = new Date(META.proximaColeta + 'T12:00:00').toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' });
  const d = new Date(META.ultimaAtualizacao + 'T12:00:00').toLocaleDateString('pt-BR', { month: 'short', year: 'numeric' });
  ['dataDiariaCategoria','dataUtilizacaoPorte','dataDisponibilidade','dataCustoManutencao','dataTecnologias','dataMaturidade','dataDores'].forEach(id => el(id).textContent = d);
}

function resumo(f, n) {
  const partes = [];
  if (f.porte !== 'todos') partes.push(PORTES[f.porte].rot);
  if (f.regiao !== 'todas') partes.push(el('filtroRegiao').selectedOptions[0].textContent);
  if (f.categoria !== 'todas') partes.push(CATS[f.categoria].rot);
  const alvo = partes.length ? partes.join(' · ') : 'Todos os recortes';
  el('resumoFiltro').innerHTML = n >= MIN_N
    ? `Mostrando <strong>${n}</strong> de ${RESPOSTAS.length} locadoras — ${alvo}`
    : `<strong>${n}</strong> locadora(s) neste recorte (${alvo}) — abaixo do mínimo de ${MIN_N} para exibir benchmark.`;
  el('resumoFiltro').classList.toggle('painel-resumo--alerta', n < MIN_N);
}

function atualizar() {
  const f = filtros(), sub = recorte(f), n = sub.length;
  resumo(f, n); renderKPIs(sub, n); renderCharts(f, sub, n); renderDores(sub, n);
  const q = new URLSearchParams();
  if (f.porte !== 'todos') q.set('porte', f.porte);
  if (f.regiao !== 'todas') q.set('regiao', f.regiao);
  if (f.categoria !== 'todas') q.set('categoria', f.categoria);
  history.replaceState(null, '', location.pathname + (q.toString() ? '?' + q : ''));
}

document.addEventListener('DOMContentLoaded', () => {
  const q = new URLSearchParams(location.search);
  [['porte', 'filtroPorte'], ['regiao', 'filtroRegiao'], ['categoria', 'filtroCategoria']].forEach(([k, id]) => {
    const v = q.get(k), s = el(id); if (v && [...s.options].some(o => o.value === v)) s.value = v;
    s.addEventListener('change', atualizar);
  });
  el('btnLimparFiltros').addEventListener('click', () => {
    el('filtroPorte').value = 'todos'; el('filtroRegiao').value = 'todas'; el('filtroCategoria').value = 'todas'; atualizar();
  });
  renderMeta(); atualizar();
});
</script>
