---
layout: base.njk
pagefind: true
pagination:
  data: collections.posts
  size: 10
  alias: lote
permalink: "/publicacoes/{% if pagination.pageNumber > 0 %}pagina-{{ pagination.pageNumber + 1 }}/{% endif %}"
---
<header class="tema-hero">
<div class="container">
<div class="breadcrumb"><a href="/">Início</a> / Todas as publicações</div>
<h1 class="page-title">Todas as publicações</h1>
</div>
</header>
<section class="container tema-wrap">
<div class="cards-artigos cards-artigos--3">
{% for post in lote %}
<a class="card-artigo" href="{{ post.url }}">
{% if post.data.image %}<img class="card-artigo__img" src="{{ post.data.image }}" alt="" loading="lazy" width="600" height="400">{% else %}<div class="card-artigo__img card-artigo__img--vazia" aria-hidden="true"></div>{% endif %}
<div class="card-artigo__corpo">
<span class="card-artigo__meta">{{ post.data.theme | themeLabel }} · Leitura de {{ post.data.readingTime or '—' }} · {{ post.date | dateBr }}</span>
<h3>{{ post.data.title }}</h3>
<p>{{ post.data.summary }}</p>
<span class="card-artigo__ler">Ler artigo →</span>
</div>
</a>
{% endfor %}
</div>
<nav class="paginacao" aria-label="Paginação">
<span>{% if pagination.href.previous %}<a href="{{ pagination.href.previous }}">← Mais recentes</a>{% endif %}</span>
<span>{% if pagination.href.next %}<a href="{{ pagination.href.next }}">Mais antigas →</a>{% endif %}</span>
</nav>
</section>
