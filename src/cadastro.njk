---
layout: base.njk
noindex: true
permalink: /cadastro/
---
<section class="auth-page">
<div class="container">
<a href="/" class="auth-logo" aria-label="oravel.org - Página inicial"><span class="o">o</span><span class="ravel">ravel</span><span class="org">.org</span></a>
<div class="form-card form-card--longo">
<div class="form-card__header">
<h1 class="form-card__title">Cadastro</h1>
<p class="form-card__subtitle">Cadastre-se para comentar nos artigos. Seu usuário é o e-mail informado, e você recebe por e-mail o link para definir a senha.</p>
</div>
<form class="form-conta" id="form-cadastro">
<div class="dupla"><label>Nome<input name="nome" autocomplete="given-name" maxlength="80" required></label><label>Sobrenome<input name="sobrenome" autocomplete="family-name" maxlength="80" required></label></div>
<label>E-mail<input type="email" name="email" autocomplete="email" required></label>
<label>Empresa<input name="empresa" autocomplete="organization" maxlength="120" required></label>
<label>WhatsApp<input type="tel" name="whatsapp" autocomplete="tel" placeholder="(11) 99999-9999" maxlength="20" required></label>
<div class="dupla"><label>Cidade<input name="cidade" autocomplete="address-level2" maxlength="80" required></label>
<label>Estado<select name="estado" required><option value="">UF</option>{% for uf in ["AC","AL","AP","AM","BA","CE","DF","ES","GO","MA","MT","MS","MG","PA","PB","PR","PE","PI","RJ","RN","RS","RO","RR","SC","SP","SE","TO"] %}<option>{{ uf }}</option>{% endfor %}</select></label></div>
<input name="site" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
<label><span><input type="checkbox" required> Concordo com a <a href="/privacidade/">política de privacidade</a> e o tratamento dos meus dados (LGPD).</span></label>
<button class="btn">Cadastrar</button>
<p class="muted" id="cadastro-msg" role="status"></p>
</form>
</div>
</div>
</section>
<script type="module" src="/assets/conta.js"></script>
