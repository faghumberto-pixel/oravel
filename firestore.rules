rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome','sobrenome','empresa','whatsapp','cidade','estado','email','criado'])
        && request.resource.data.nome is string && request.resource.data.nome.size() < 80
        && request.resource.data.sobrenome is string && request.resource.data.sobrenome.size() < 80
        && request.resource.data.empresa is string && request.resource.data.empresa.size() < 120;
      allow read: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if false;
    }
    match /comentarios/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['slug','uid','autor','texto','criado'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 2000
        && request.resource.data.slug is string && request.resource.data.slug.size() < 200
        && request.resource.data.autor is string && request.resource.data.autor.size() < 120
        && request.resource.data.criado == request.time;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
  
    match /gazeta_assinantes/{email} {
      allow create: if request.resource.data.keys().hasOnly(['email','criado'])
        && request.resource.data.email is string
        && request.resource.data.email == email
        && email == email.lower()
        && email.size() <= 254
        && email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.criado == request.time;
      allow read, update, delete: if false;
    }
  }
}
