rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome','sobrenome','empresa','whatsapp','cidade','estado','email','criado'])
        && request.resource.data.nome is string && request.resource.data.nome.size() < 80
        && request.resource.data.sobrenome is string && request.resource.data.sobrenome.size() < 80
        && request.resource.data.empresa is string && request.resource.data.empresa.size() < 120;
      allow read: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if false;
    }
    // Fila da extensão Trigger Email: um aviso por usuário, sempre para contato@oravel.org
    match /mail/{id} {
      allow create: if request.auth != null
        && id == 'cadastro-' + request.auth.uid
        && request.resource.data.keys().hasOnly(['to','message'])
        && request.resource.data.to == ['contato@oravel.org']
        && request.resource.data.message.keys().hasOnly(['subject','text'])
        && request.resource.data.message.subject is string && request.resource.data.message.subject.size() < 200
        && request.resource.data.message.subject.matches('Novo cadastro no oravel.org: .*')
        && request.resource.data.message.text is string && request.resource.data.message.text.size() < 1000;
      allow read, update, delete: if false;
    }
    match /comentarios/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['slug','uid','autor','texto','criado'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 2000
        && request.resource.data.slug is string && request.resource.data.slug.size() < 200
        && request.resource.data.autor is string && request.resource.data.autor.size() < 120
        && request.resource.data.criado == request.time;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
  
  }
}
