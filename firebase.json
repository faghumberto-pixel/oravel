{
  "hosting": {
    "public": "_site",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "README.md"
    ],
    "headers": [
      {
        "source": "/gazeta/obrigado/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/assets/gazeta/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/observatorio/fontes",
        "destination": "/painel-mercado/",
        "type": 301
      },
      {
        "source": "/observatorio/fontes/",
        "destination": "/painel-mercado/",
        "type": 301
      },
      {
        "source": "/observatorio/participantes",
        "destination": "/observatorio/",
        "type": 301
      },
      {
        "source": "/observatorio/participantes/",
        "destination": "/observatorio/",
        "type": 301
      },
      {
        "source": "/observatorio/dados/**",
        "destination": "/observatorio/",
        "type": 301
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
